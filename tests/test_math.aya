import "math"

fn main() -> int {
    if abs(-5) != 5 { return 1 }
    if abs(5) != 5 { return 2 }
    if min(3, 7) != 3 { return 3 }
    if max(3, 7) != 7 { return 4 }
    if clamp(10, 0, 5) != 5 { return 5 }
    if clamp(-1, 0, 5) != 0 { return 6 }
    if pow(2, 10) != 1024 { return 7 }
    if abs(-1.5) != 1.5 { return 8 }
    if min(1.0, 2.0) != 1.0 { return 9 }
    if max(1.0, 2.0) != 2.0 { return 10 }
    if clamp(3.0, 0.0, 2.0) != 2.0 { return 11 }
    if sqrt(9.0) != 3.0 { return 12 }
    if floor(1.9) != 1.0 { return 13 }
    if ceil(1.1) != 2.0 { return 14 }
    if pow(2.0, 3) != 8.0 { return 15 }
    return 0
}
