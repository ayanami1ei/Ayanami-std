import "arraylist"

fn main() -> int {
    a = ArrayList::new[int]()
    if !a.is_empty() { return 1 }
    if a.len() != 0 { return 2 }
    a.push(1)
    a.push(2)
    a.push(3)
    if a.len() != 3 { return 3 }
    if a.index(1) != 2 { return 4 }
    a.set(1, 9)
    if a.index(1) != 9 { return 5 }
    if a.pop() != 3 { return 6 }
    if a.len() != 2 { return 7 }
    if a.to_string() != "[1, 9]" { return 8 }
    a.clear()
    if a.len() != 0 { return 9 }
    if !a.is_empty() { return 10 }
    b = ArrayList::with_capacity[int](4)
    b.push(5)
    if b.index(0) != 5 { return 11 }
    if b.len() != 1 { return 12 }
    return 0
}
