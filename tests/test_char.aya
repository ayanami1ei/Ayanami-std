import "string"

fn main() -> int {
    if char_code('A') != 65 { return 1 }
    if !'7'.is_digit() { return 2 }
    if !'a'.is_alpha() { return 3 }
    if !'a'.is_alnum() { return 4 }
    if !' '.is_space() { return 5 }
    if !'A'.is_upper() { return 6 }
    if !'a'.is_lower() { return 7 }
    if '7'.to_digit() != 7 { return 8 }
    if 'a'.to_upper() != 'A' { return 9 }
    if 'A'.to_lower() != 'a' { return 10 }
    if 'a'.is_digit() { return 11 }
    if '7'.is_alpha() { return 12 }
    return 0
}
