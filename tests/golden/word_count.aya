import "hashmap"
import "text"
import "io"

fn main() -> int {
    s = "the quick brown fox jumps over the lazy dog the fox"
    words = split(s, " ")
    counts = HashMap::new[String, int]()
    i = 0usize
    while i < words.len {
        w = words.index(i)
        old = counts.get(w).unwrap_or(0)
        counts.insert(w, old + 1)
        i = i + 1
    }
    n = counts.len() as int
    println(n)
    println(counts.get("the").unwrap_or(0))
    println(counts.get("fox").unwrap_or(0))
    println(counts.get("dog").unwrap_or(0))
    println(counts.get("cat").unwrap_or(0))
    return 0
}
