// custom_alloc — 自定义全局分配器（覆盖运行时弱符号）
//
// 在 Ayanami 内导出与运行时同名的 extern "C" 定义：链接期强符号覆盖弱符号，
// 编译器生成的分配调用（String 拼接、数组、集合缓冲等）全部走自定义实现。
// 本示例：转发默认分配原语（绕过 live_allocs 计数，故 delta 为 0）。
import "alloc";

import "io";

import "string";

#[extern]
fn __ayanami_default_alloc(usize size) -> usize;

#[extern]
fn __ayanami_default_free(usize addr);

#[extern]
fn __ayanami_unique_alloc(usize size) -> usize {
    return __ayanami_default_alloc(size);
}

#[extern]
fn __ayanami_unique_free(usize addr) {
    __ayanami_default_free(addr)
}

fn main() -> int {
    before = live_allocs();
    s = "custom " + "allocator";
    delta = live_allocs() - before;
    println(s);
    println(delta);
    return 0;
}
