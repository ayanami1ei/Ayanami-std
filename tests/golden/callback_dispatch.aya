import "hashmap"
import "io"

fn triple(int x) -> int {
    return x * 3
}

fn main() -> int {
    base = 100
    m = HashMap::new[String, Fn(int) -> int]()
    m.insert("add", (int x) -> int { return x + base })
    m.insert("double", (int x) -> int { return x * 2 })
    m.insert("triple", triple)

    o = m.get("add")
    if o._tag != 0 {
        return 1
    }
    f = o._data_Some._0
    println(f(5))

    o2 = m.get("double")
    if o2._tag != 0 {
        return 2
    }
    g = o2._data_Some._0
    println(g(5))

    o3 = m.get("triple")
    if o3._tag != 0 {
        return 3
    }
    h = o3._data_Some._0
    println(h(5))
    return 0
}
