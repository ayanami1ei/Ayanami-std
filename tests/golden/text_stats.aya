// text_stats — 文本统计示例
//
// 演示：split_whitespace + fold + count 组合。
import "text"
import "io"

fn main() -> int {
    s = "the quick brown fox\njumps over the lazy dog\nthe fox"
    ws = split_whitespace(s)
    n = ws.len() as int
    println("words: " + n)

    longest = ws.fold("", (String acc, String w) -> String {
        if w.len > acc.len {
            return w
        }
        return acc
    })
    println("longest: " + longest)
    println("the: " + count(s, "the"))
    return 0
}
