// text_pipeline — 迭代器管道示例
//
// split_whitespace_iter → FilterIter（长词）→ MapIter（大写）→ for 输出。
import "iter"
import "text"
import "io"

fn main() -> int {
    s = "the quick brown fox jumps over the lazy dog"
    words = s.split_whitespace_iter()
    long = FilterIter::new(words, (String w) -> bool { return w.len > 4 })
    upper = MapIter::new(long, (String w) -> String { return w.to_upper() })
    n = 0
    for w in upper {
        println(w)
        n = n + 1
    }
    println(n)
    return 0
}
