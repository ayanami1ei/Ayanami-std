import "string"

fn main() -> int {
    if "abc".len() != 3 { return 1 }
    if "abc".index(1) != 'b' { return 2 }
    if !"hello".contains("ell") { return 3 }
    if !"hello".starts_with("he") { return 4 }
    if !"hello".ends_with("lo") { return 5 }
    if "hello".index_of("ll") != 2 { return 6 }
    if "hello".index_of("x") != -1 { return 7 }
    if "abcdef".substring(1, 3) != "bc" { return 8 }
    if "  hi  ".trim() != "hi" { return 9 }
    if "ab".to_upper() != "AB" { return 10 }
    if "AB".to_lower() != "ab" { return 11 }
    if "ab".repeat(3) != "ababab" { return 12 }
    if "123".parse_int() != 123 { return 13 }
    if !"42".is_int() { return 14 }
    if "12a".is_int() { return 15 }
    if "a" + "b" != "ab" { return 16 }
    if 42.to_string() != "42" { return 17 }
    if true.to_string() != "true" { return 18 }
    if 'x'.to_string() != "x" { return 19 }
    if !"".is_empty() { return 20 }
    if "ab".copy() != "ab" { return 21 }
    if !String::empty().is_empty() { return 22 }
    if !String::new().is_empty() { return 23 }
    return 0
}
