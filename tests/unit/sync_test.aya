import "sync";

import "test";

#[test]
fn test_atomic_load_store() {
    a = AtomicInt::new(5);
    #assert_eq(a.load(), 5);
    a.store(42);
    #assert_eq(a.load(), 42)
}

#[test]
fn test_atomic_swap() {
    a = AtomicInt::new(1);
    #assert_eq(a.swap(9), 1);
    #assert_eq(a.load(), 9)
}

#[test]
fn test_atomic_fetch_add_sub() {
    a = AtomicInt::new(10);
    #assert_eq(a.fetch_add(5), 10);
    #assert_eq(a.load(), 15);
    #assert_eq(a.fetch_sub(3), 15);
    #assert_eq(a.load(), 12);
    #assert_eq(a.fetch_add(-2), 12);
    #assert_eq(a.load(), 10)
}

#[test]
fn test_atomic_bitwise_cas() {
    a = AtomicInt::new(10);
    #assert_eq(a.fetch_or(5), 10);
    #assert_eq(a.load(), 15);
    #assert_eq(a.fetch_and(12), 15);
    #assert_eq(a.load(), 12);
    #assert_eq(a.fetch_xor(15), 12);
    #assert_eq(a.load(), 3);
    #assert_eq(a.compare_exchange(3, 7), 3);
    #assert_eq(a.load(), 7);
    #assert_eq(a.compare_exchange(99, 8), 7);
    #assert_eq(a.load(), 7)
}

#[test]
fn test_atomic_field_of_struct() {
    b = Holder { count = AtomicInt::new(7) };
    #assert_eq(b.count.fetch_add(1), 7);
    #assert_eq(b.count.load(), 8)
}

#[test]
fn test_fence_and_relax() {
    fence();
    cpu_relax();
    #assert_eq(1, 1)
}

#[test]
fn test_spinlock_from_swap() {
    // 单线程自旋锁语义（多线程争用由 S2 线程落地后覆盖）
    lock = AtomicInt::new(0);
    counter = 0;
    while lock.swap(1) != 0 {
        cpu_relax();
    }
    counter = counter + 1;
    lock.store(0);
    #assert_eq(counter, 1);
    #assert_eq(lock.load(), 0)
}

struct Holder {
    AtomicInt count
}
