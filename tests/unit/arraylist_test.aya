import "arraylist"
import "test"

#[test]
fn test_basic() {
    a = ArrayList::new[int]()
    #assert(a.is_empty())
    #assert_eq(a.len(), 0)
    a.push(1)
    a.push(2)
    a.push(3)
    #assert_eq(a.len(), 3)
    #assert_eq(a.index(1), 2)
    a.set(1, 9)
    #assert_eq(a.index(1), 9)
    #assert_eq(a.pop(), 3)
    #assert_eq(a.len(), 2)
    #assert_eq(a.to_string(), "[1, 9]")
    a.clear()
    #assert(a.is_empty())
}

#[test]
fn test_capacity() {
    b = ArrayList::with_capacity[int](4)
    b.push(5)
    #assert_eq(b.index(0), 5)
    #assert_eq(b.len(), 1)
}

#[test]
fn test_contains_index_of() {
    a = ArrayList::new[int]()
    a.push(10)
    a.push(20)
    a.push(30)
    #assert(a.contains(20))
    #assert(!a.contains(99))
    #assert_eq(a.index_of(30), 2)
    #assert_eq(a.index_of(99), -1)
    #assert(a.remove(20))
    #assert_eq(a.len(), 2)
    #assert(!a.contains(20))
    #assert(!a.remove(20))
}

#[test]
fn test_contains_string() {
    l = ArrayList::new[String]()
    l.push("a")
    l.push("b")
    #assert(l.contains("b"))
    #assert_eq(l.index_of("a"), 0)
    #assert(l.remove("a"))
    #assert_eq(l.len(), 1)
    #assert_eq(l.index(0), "b")
}

#[test]
fn test_reverse() {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    a.push(3)
    a.reverse()
    #assert_eq(a.index(0), 3)
    #assert_eq(a.index(1), 2)
    #assert_eq(a.index(2), 1)
    e = ArrayList::new[int]()
    e.reverse()
    #assert(e.is_empty())
}

#[test]
fn test_insert_remove_at() {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(3)
    a.insert_at(1, 2)
    #assert_eq(a.len(), 3)
    #assert_eq(a.index(1), 2)
    a.remove_at(0)
    #assert_eq(a.index(0), 2)
    n = a.len()
    a.insert_at(n, 9)
    #assert_eq(a.index(2), 9)
}

#[test]
fn test_first_last() {
    a = ArrayList::new[int]()
    a.push(5)
    a.push(7)
    #assert_eq(a.first(), 5)
    #assert_eq(a.last(), 7)
}

#[test]
fn test_map_filter() {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    a.push(3)
    b = a.map((int x) -> int { return x * 10 })
    #assert_eq(b.len(), 3)
    #assert_eq(b.index(0), 10)
    #assert_eq(b.index(2), 30)
    c = a.filter((int x) -> bool { return x > 1 })
    #assert_eq(c.len(), 2)
    #assert_eq(c.index(0), 2)
}

#[test]
fn test_fold_any_all_find() {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    a.push(3)
    s = a.fold(0, (int acc, int x) -> int { return acc + x })
    #assert_eq(s, 6)
    #assert(a.any((int x) -> bool { return x == 2 }))
    #assert(!a.any((int x) -> bool { return x == 9 }))
    #assert(a.all((int x) -> bool { return x > 0 }))
    #assert(!a.all((int x) -> bool { return x > 1 }))
    f = a.find((int x) -> bool { return x > 1 })
    #assert_eq(f.unwrap_or(0), 2)
    g = a.find((int x) -> bool { return x > 9 })
    #assert(g.is_none())
}

#[test]
fn test_capture_filter() {
    limit = 2
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    a.push(3)
    b = a.filter((int x) -> bool { return x > limit })
    #assert_eq(b.len(), 1)
    #assert_eq(b.index(0), 3)
}

#[test]
fn test_retain_position_count() {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    a.push(3)
    a.push(4)
    #assert_eq(a.count((int x) -> bool { return x % 2 == 0 }), 2)
    #assert_eq(a.position((int x) -> bool { return x > 2 }), 2)
    #assert_eq(a.position((int x) -> bool { return x > 9 }), -1)
    a.retain((int x) -> bool { return x % 2 == 0 })
    #assert_eq(a.len(), 2)
    #assert_eq(a.index(0), 2)
    #assert_eq(a.index(1), 4)
}
