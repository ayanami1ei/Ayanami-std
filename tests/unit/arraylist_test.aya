import "arraylist"
import "test"

#[test]
fn test_basic() {
    a = ArrayList::new[int]()
    #assert(a.is_empty())
    #assert_eq(a.len(), 0)
    a.push(1)
    a.push(2)
    a.push(3)
    #assert_eq(a.len(), 3)
    #assert_eq(a.index(1), 2)
    a.set(1, 9)
    #assert_eq(a.index(1), 9)
    #assert_eq(a.pop(), 3)
    #assert_eq(a.len(), 2)
    #assert_eq(a.to_string(), "[1, 9]")
    a.clear()
    #assert(a.is_empty())
}

#[test]
fn test_capacity() {
    b = ArrayList::with_capacity[int](4)
    b.push(5)
    #assert_eq(b.index(0), 5)
    #assert_eq(b.len(), 1)
}
