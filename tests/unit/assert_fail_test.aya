import "std"
import "test"

fn some3() -> Option[int] {
    return Option::Some(3)
}

#[should_panic]
fn test_lt_fail() -> int {
    #assert_lt(2, 1)
    return 0
}

#[should_panic]
fn test_contains_fail() -> int {
    #assert_contains("hello", "xyz")
    return 0
}

#[should_panic]
fn test_none_fail() -> int {
    #assert_none(some3())
    return 0
}

#[should_panic]
fn test_close_fail() -> int {
    #assert_close(1.0, 2.0, 0.1)
    return 0
}

#[should_panic]
fn test_fail_macro() -> int {
    #fail("custom failure")
    return 0
}
