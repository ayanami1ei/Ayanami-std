import "std"
import "test"

fn some3() -> Option[int] {
    return Option::Some(3)
}

#[should_panic]
fn test_lt_fail() {
    #assert_lt(2, 1)
}

#[should_panic]
fn test_contains_fail() {
    #assert_contains("hello", "xyz")
}

#[should_panic]
fn test_none_fail() {
    #assert_none(some3())
}

#[should_panic]
fn test_close_fail() {
    #assert_close(1.0, 2.0, 0.1)
}

#[should_panic]
fn test_fail_macro() {
    #fail("custom failure")
}
