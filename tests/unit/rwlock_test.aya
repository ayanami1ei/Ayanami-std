import "sync";

import "thread";

import "test";

#[test]
fn test_rwlock_single_thread() {
    l = RwLock::new[int](5);
    v = l.with_read((ref int x) -> int { *x });
    #assert_eq(v, 5);
    l.with_write((ref mut int x) -> void { *x = *x + 1 });
    v2 = l.with_read((ref int x) -> int { *x });
    #assert_eq(v2, 6)
}

// 并发体放在普通函数（多线程 + 自旋等待）
fn rw_write_run() -> int {
    l = RwLock::new[int](0);
    done = AtomicInt::new(0);
    unsafe {
        pl = ref l as *RwLock[int]
        pd = ref done as *AtomicInt
        i = 0;
        while i < 4 {
            Thread::spawn(() -> void {
                unsafe {
                    (*pl).with_write((ref mut int v) -> void { *v = *v + 10 });
                    (*pd).fetch_add(1)
                }
            })
            i = i + 1
        }
        while done.load() < 4 {
            cpu_relax()
        }
    }
    return l.with_read((ref int v) -> int { *v })
}

#[test]
fn test_rwlock_concurrent_writers() {
    #assert_eq(rw_write_run(), 40)
}

fn rw_read_run() -> int {
    l = RwLock::new[int](7);
    done = AtomicInt::new(0);
    unsafe {
        pl = ref l as *RwLock[int]
        pd = ref done as *AtomicInt
        i = 0;
        while i < 4 {
            Thread::spawn(() -> void {
                unsafe {
                    v = (*pl).with_read((ref int x) -> int { *x });
                    if v == 7 {
                        (*pd).fetch_add(1)
                    }
                }
            })
            i = i + 1
        }
        while done.load() < 4 {
            cpu_relax()
        }
    }
    return done.load()
}

#[test]
fn test_rwlock_concurrent_readers() {
    #assert_eq(rw_read_run(), 4)
}
