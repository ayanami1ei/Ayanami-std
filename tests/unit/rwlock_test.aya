import "sync";

import "thread";

import "test";

#[test]
fn test_rwlock_single_thread() {
    l = RwLock::new[int](5);
    v = l.with_read((ref int x) -> int { *x });
    #assert_eq(v, 5);
    l.with_write((ref mut int x) -> void { *x = *x + 1 });
    v2 = l.with_read((ref int x) -> int { *x });
    #assert_eq(v2, 6)
}

#[test]
fn test_rwlock_try() {
    l = RwLock::new[int](3);
    r = l.try_with_read((ref int x) -> int { *x });
    #assert_eq(r.unwrap(), 3);
    w = l.try_with_write((ref mut int x) -> int {
        *x = 4;
        return *x
    });
    #assert_eq(w.unwrap(), 4);
    // 读锁持有时写锁失败（单线程下通过显式加锁模拟）
    l.lock_read();
    failed = l.try_with_write((ref mut int x) -> int { *x });
    #assert(failed.is_none());
    l.unlock_read();
    ok = l.try_with_write((ref mut int x) -> int { *x });
    #assert_eq(ok.unwrap(), 4)
}

// 并发体放在普通函数（多线程 + 自旋等待）
fn rw_write_run() -> int {
    l = RwLock::new[int](0);
    done = AtomicInt::new(0);
    unsafe {
        pl = ref l as *RwLock[int]
        pd = ref done as *AtomicInt
        i = 0;
        while i < 4 {
            Thread::spawn(() -> void {
                unsafe {
                    (*pl).with_write((ref mut int v) -> void { *v = *v + 10 });
                    (*pd).fetch_add(1)
                }
            })
            i = i + 1
        }
        while done.load() < 4 {
            cpu_relax()
        }
    }
    return l.with_read((ref int v) -> int { *v })
}

#[test]
fn test_rwlock_concurrent_writers() {
    #assert_eq(rw_write_run(), 40)
}

fn rw_read_run() -> int {
    l = RwLock::new[int](7);
    done = AtomicInt::new(0);
    unsafe {
        pl = ref l as *RwLock[int]
        pd = ref done as *AtomicInt
        i = 0;
        while i < 4 {
            Thread::spawn(() -> void {
                unsafe {
                    v = (*pl).with_read((ref int x) -> int { *x });
                    if v == 7 {
                        (*pd).fetch_add(1)
                    }
                }
            })
            i = i + 1
        }
        while done.load() < 4 {
            cpu_relax()
        }
    }
    return done.load()
}

#[test]
fn test_rwlock_concurrent_readers() {
    #assert_eq(rw_read_run(), 4)
}
