import "json";

import "arraylist";

import "iter";

import "test";

#[test]
fn test_json_escape() {
    #assert_eq(escape(ref "hi"), "hi");
    #assert_eq(escape(ref "a\"b"), "a\\\"b");
    #assert_eq(escape(ref "a\\b"), "a\\\\b");
    #assert_eq(escape(ref "a\nb"), "a\\nb");
    #assert_eq(escape(ref "\t"), "\\t");
    #assert_eq(quote(ref "hi"), "\"hi\"")
}

#[test]
fn test_json_unescape() {
    #assert_eq(unescape(ref "a\\nb").unwrap(), "a\nb");
    #assert_eq(unescape(ref "\\u0041").unwrap(), "A");
    #assert_eq(unescape(ref "\\u4f60\\u597d").unwrap(), "你好");
    #assert_eq(unescape(ref "\\uD83D\\uDE00").unwrap(), "😀");
    #assert(unescape(ref "\\q").is_none());
    #assert(unescape(ref "\\u12").is_none());
    #assert(unescape(ref "\\uD83D").is_none())
}

#[test]
fn test_json_escape_roundtrip() {
    cases = ArrayList::new[String]();
    cases.push("");
    cases.push("plain");
    cases.push("a\"b\\c");
    cases.push("line1\nline2\t!");
    cases.push("你好，世界 😀");
    for s in cases.into_iter() {
        e = escape(ref s);
        d = unescape(ref e).unwrap();
        #assert_eq(d, s)
    }
}

#[test]
fn test_json_render_scalars() {
    #assert_eq(Json::Null.render(), "null");
    #assert_eq(Json::Bool(true).render(), "true");
    #assert_eq(Json::Int(-42).render(), "-42");
    #assert_eq(Json::Float(3.5).render(), "3.5");
    #assert_eq(Json::Str("say \"hi\"").render(), "\"say \\\"hi\\\"\"")
}

#[test]
fn test_json_render_nested() {
    arr = ArrayList::new[Json]();
    arr.push(Json::Int(1));
    arr.push(Json::Str("a"));
    arr.push(Json::Bool(false));
    fields = ArrayList::new[JsonField]();
    fields.push(JsonField::new("a", Json::Int(1)));
    inner = ArrayList::new[Json]();
    inner.push(Json::Int(2));
    inner.push(Json::Int(3));
    fields.push(JsonField::new("b", Json::Array(inner)));
    obj = Json::Object(fields);
    #assert_eq(Json::Array(arr).render(), "[1,\"a\",false]");
    #assert_eq(obj.render(), "{\"a\":1,\"b\":[2,3]}")
}

#[test]
fn test_json_parse_scalars() {
    #assert_eq(parse(ref "null").unwrap().render(), "null");
    #assert_eq(parse(ref " true ").unwrap().render(), "true");
    #assert_eq(parse(ref "123").unwrap().render(), "123");
    #assert_eq(parse(ref "1.5").unwrap().render(), "1.5");
    #assert_eq(parse(ref "\"hi\"").unwrap().render(), "\"hi\"");
    #assert_eq(parse(ref "\"\\u4f60\\u597d\"").unwrap().render(), "\"你好\"")
}

#[test]
fn test_json_parse_containers() {
    text = "{\"a\":[1,2,3],\"b\":{\"c\":true},\"s\":\"x\"}";
    p = parse(ref text).unwrap();
    #assert_eq(p.render(), text);
    spaced = "{ \"a\" : [ 1 , 2 ] }";
    #assert_eq(parse(ref spaced).unwrap().render(), "{\"a\":[1,2]}");
    #assert_eq(parse(ref "[]").unwrap().render(), "[]");
    #assert_eq(parse(ref "{}").unwrap().render(), "{}")
}

#[test]
fn test_json_parse_invalid() {
    #assert(parse(ref "").is_none());
    #assert(parse(ref "tru").is_none());
    #assert(parse(ref "[1,]").is_none());
    #assert(parse(ref "{\"a\":}").is_none());
    #assert(parse(ref "01").is_none());
    #assert(parse(ref "1 2").is_none());
    #assert(parse(ref "\"\\u12\"").is_none());
    #assert(parse(ref "{a:1}").is_none())
}

#[test]
fn test_json_accessors() {
    v = parse(ref "{\"name\":\"aya\",\"n\":42,\"ok\":true,\"arr\":[1,\"x\",false]}").unwrap();
    #assert_eq(v.get_str(ref "name").unwrap(), "aya");
    #assert_eq(v.get_int(ref "n").unwrap(), 42);
    #assert_eq(v.get_bool(ref "ok").unwrap(), true);
    #assert(v.get_str(ref "n").is_none());
    #assert_eq(v.get_tag(ref "arr"), 5);
    #assert_eq(v.len(), 4);
    #assert_eq(v.key_at(0usize).unwrap(), "name");
    #assert_eq(v.get_int(ref "missing").is_none(), true);
    arr = parse(ref "[1,2.5,true,\"s\"]").unwrap();
    #assert_eq(arr.len(), 4);
    #assert_eq(arr.at_int(0usize).unwrap(), 1);
    #assert_eq(arr.at_float(1usize).unwrap(), 2.5);
    #assert_eq(arr.at_bool(2usize).unwrap(), true);
    #assert_eq(arr.at_str(3usize).unwrap(), "s");
    #assert_eq(arr.at_tag(0usize), 2);
    #assert(arr.at_int(9usize).is_none());
    n = parse(ref "null").unwrap();
    #assert(n.is_null());
    #assert(!n.as_int().is_some())
}

#[test]
fn test_json_render_pretty() {
    v = parse(ref "{\"a\":[1,2],\"b\":{\"c\":true}}").unwrap();
    expected = "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": {\n    \"c\": true\n  }\n}";
    #assert_eq(v.render_pretty(), expected);
    #assert_eq(parse(ref "[]").unwrap().render_pretty(), "[]");
    #assert_eq(parse(ref "{}").unwrap().render_pretty(), "{}");
    #assert_eq(parse(ref "42").unwrap().render_pretty(), "42")
}
