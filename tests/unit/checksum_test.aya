import "checksum";

import "test";

#[test]
fn test_crc32_vectors() {
    #assert_eq(crc32(ref ""), 0);
    #assert_eq(crc32(ref "123456789"), 3421780262);
    #assert_eq(crc32(ref "hello"), 907060870);
    #assert_eq(crc32(ref "hello world"), 222957957)
}

#[test]
fn test_crc32_hex() {
    #assert_eq(crc32_hex(ref ""), "00000000");
    #assert_eq(crc32_hex(ref "123456789"), "cbf43926");
    #assert_eq(crc32_hex(ref "hello"), "3610a686")
}
