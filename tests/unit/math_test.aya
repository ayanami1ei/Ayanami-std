import "math";

import "test";

#[test]
fn test_int_ops() {
    #assert_eq(abs(-5), 5);
    #assert_eq(abs(5), 5);
    #assert_eq(min(3, 7), 3);
    #assert_eq(max(3, 7), 7);
    #assert_eq(clamp(10, 0, 5), 5);
    #assert_eq(clamp(-1, 0, 5), 0);
    #assert_eq(pow(2, 10), 1024)
}

#[test]
fn test_float_ops() {
    #assert_eq(abs(-1.5), 1.5);
    #assert_eq(min(1.0, 2.0), 1.0);
    #assert_eq(max(1.0, 2.0), 2.0);
    #assert_eq(clamp(3.0, 0.0, 2.0), 2.0);
    #assert_eq(sqrt(9.0), 3.0);
    #assert_eq(floor(1.9), 1.0);
    #assert_eq(ceil(1.1), 2.0);
    #assert_eq(pow(2.0, 3), 8.0)
}

#[test]
fn test_gcd_lcm() {
    #assert_eq(gcd(12, 18), 6);
    a = 0 - 12;
    #assert_eq(gcd(a, 18), 6);
    #assert_eq(gcd(7, 13), 1);
    #assert_eq(gcd(0, 5), 5);
    #assert_eq(lcm(4, 6), 12);
    #assert_eq(lcm(0, 5), 0)
}

#[test]
fn test_prime_even() {
    #assert(!is_prime(1));
    #assert(is_prime(2));
    #assert(is_prime(97));
    #assert(!is_prime(91));
    #assert(4.is_even());
    #assert(7.is_odd());
    m = 0 - 3;
    #assert(m.is_odd());
    n = 0 - 4;
    #assert(n.is_even())
}

#[test]
fn test_nan() {
    n = sqrt(0.0 - 1.0);
    #assert(n.is_nan());
    #assert(!1.5.is_nan())
}

#[test]
fn test_exp_log_round() {
    #assert_close(exp(0.0), 1.0, 0.0001);
    #assert_close(ln(1.0), 0.0, 0.0001);
    #assert_close(log10(1000.0), 3.0, 0.0001);
    #assert_close(round(2.5), 3.0, 0.0001);
    #assert_close(round(2.4), 2.0, 0.0001);
    #assert_close(round(0.0 - 2.5), 0.0 - 3.0, 0.0001);
    #assert_close(trunc(2.9), 2.0, 0.0001);
    #assert_close(trunc(0.0 - 2.9), 0.0 - 2.0, 0.0001)
}

#[test]
fn test_trig() {
    #assert_close(sin(0.0), 0.0, 0.0001);
    #assert_close(cos(0.0), 1.0, 0.0001);
    #assert_close(sin(pi() / 2.0), 1.0, 0.0001);
    #assert_close(cos(pi()), 0.0 - 1.0, 0.0001);
    #assert_close(tan(0.0), 0.0, 0.0001);
    #assert_close(atan2(1.0, 1.0), pi() / 4.0, 0.0001)
}

#[test]
fn test_sign() {
    #assert_eq(sign(0 - 5), -1);
    #assert_eq(sign(0), 0);
    #assert_eq(sign(7), 1)
}

#[test]
fn test_pow_negative() {
    #assert_close(pow(2.0, 0 - 2), 0.25, 0.0001);
    #assert_close(pow(2.0, 0 - 1), 0.5, 0.0001);
    #assert_close(pow(2.0, 3), 8.0, 0.0001)
}

#[test]
fn test_usize_minmax() {
    a = 3usize;
    b = 7usize;
    #assert_eq(min(a, b), 3usize);
    #assert_eq(max(a, b), 7usize);
    #assert_eq(clamp(10usize, 0usize, 5usize), 5usize)
}
