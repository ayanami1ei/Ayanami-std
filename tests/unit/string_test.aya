#[test]
fn test_tostring() {
    #assert_eq(42.to_string(), "42")
    #assert_eq(true.to_string(), "true")
    #assert_eq('x'.to_string(), "x")
}

#[test]
fn test_bases() {
    a = 255
    #assert_eq(a.to_hex(), "ff")
    #assert_eq(a.to_hex_upper(), "FF")
    #assert_eq(a.to_oct(), "377")
    #assert_eq(a.to_bin(), "11111111")
    z = 0
    #assert_eq(z.to_hex(), "0")
    n = 0 - 255
    #assert_eq(n.to_hex(), "-ff")
    big = 2147483647
    #assert_eq(big.to_hex(), "7fffffff")
}

#[test]
fn test_trim_edges() {
    s = "  hi  "
    #assert_eq(s.trim_start(), "hi  ")
    #assert_eq(s.trim_end(), "  hi")
    #assert_eq(s.trim(), "hi")
    blank = "   "
    #assert(blank.trim_start().is_empty())
    #assert(blank.trim_end().is_empty())
}

#[test]
fn test_float_format() {
    x = 3.14159
    #assert_eq(x.to_fixed(2), "3.14")
    #assert_eq(x.to_fixed(0), "3")
    y = 1234.5
    #assert_eq(y.to_sci(2), "1.23e+03")
    #assert_eq(y.to_sci(0), "1e+03")
    z = 0 - 1.5
    #assert_eq(z.to_fixed(1), "-1.5")
    w = 1000000.0
    #assert_eq(w.to_fixed(0), "1000000")
}

#[test]
fn test_remove_affix() {
    s = "pre-hello-post"
    #assert_eq(s.remove_prefix("pre-"), "hello-post")
    #assert_eq(s.remove_prefix("xxx"), "pre-hello-post")
    #assert_eq(s.remove_suffix("-post"), "pre-hello")
    #assert_eq(s.remove_suffix("xxx"), "pre-hello-post")
}

#[test]
fn test_self_append() {
    s = "ab"
    s = s.add("cd")
    #assert_eq(s, "abcd")
    t = "x"
    t = t + "y"
    #assert_eq(t, "xy")
    u = ""
    u = u + "a"
    u = u + "b"
    #assert_eq(u, "ab")
}
