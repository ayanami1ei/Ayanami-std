import "test"
import "time"

#[test]
fn test_time() {
    t1 = now_millis()
    t2 = now_millis()
    #assert(t2 >= t1)
    #assert(now_unix() > 0)
}

#[test]
fn test_sleep() {
    t1 = now_millis()
    sleep_ms(30)
    t2 = now_millis()
    #assert(t2 - t1 >= 25)
}

#[test]
fn test_elapsed() {
    t = now_millis()
    #assert(elapsed_ms(t) >= 0)
    sleep_ms(20)
    #assert(elapsed_ms(t) >= 15)
}
