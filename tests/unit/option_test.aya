import "option";

import "test";

fn some_int(int v) -> Option[int] {
    return Option::Some(v);
}

fn none_int() -> Option[int] {
    return Option::None();
}

fn seven() -> int {
    return 7;
}

#[test]
fn test_option_map() {
    a = some_int(3);
    b = a.map((int x) -> int {
        return x + 1;
    });
    #assert_eq(b.unwrap_or(0), 4);
    c = none_int();
    d = c.map((int x) -> int {
        return x + 1;
    });
    #assert(d.is_none())
}

#[test]
fn test_option_chain() {
    a = some_int(3);
    b = a.and_then((int x) -> Option[int] {
        return some_int(x * 2);
    });
    #assert_eq(b.unwrap_or(0), 6);
    c = some_int(3);
    d = c.filter((int x) -> bool {
        return x > 5;
    });
    #assert(d.is_none());
    e = some_int(3);
    f = e.filter((int x) -> bool {
        return x > 2;
    });
    #assert_eq(f.unwrap_or(0), 3)
}

#[test]
fn test_option_chained() {
    r = some_int(3).map((int x) -> int {
        return x + 1;
    }).filter((int x) -> bool {
        return x > 3;
    });
    #assert_eq(r.unwrap_or(0), 4)
}

fn ok_int(int v) -> Result[int, int] {
    return Result::Ok(v);
}

fn err_int(int v) -> Result[int, int] {
    return Result::Err(v);
}

#[test]
fn test_result_map() {
    r = ok_int(2);
    s = r.map((int x) -> int {
        return x * 10;
    });
    #assert_eq(s.unwrap_or(0), 20);
    e = ok_int(2);
    f = e.map_err((int x) -> int {
        return x + 1;
    });
    #assert_eq(f.unwrap_or(0), 2);
    g = err_int(5);
    h = g.map((int x) -> int {
        return x * 10;
    });
    #assert(h.is_err())
}

#[test]
fn test_unwrap_or_else_map_or() {
    a = some_int(3);
    #assert_eq(a.unwrap_or_else(() -> int {
        return 7;
    }), 3);
    b = none_int();
    #assert_eq(b.unwrap_or_else(seven), 7);  // 命名零参函数（#152 修复）
    c = some_int(3);
    #assert_eq(c.map_or(0, (int x) -> int {
        return x * 10;
    }), 30);
    d = none_int();
    #assert_eq(d.map_or(0, (int x) -> int {
        return x * 10;
    }), 0)
}

#[test]
fn test_result_unwrap_or_else_map_or() {
    r = ok_int(2);
    #assert_eq(r.unwrap_or_else((int e) -> int {
        return e * 100;
    }), 2);
    e = err_int(5);
    #assert_eq(e.unwrap_or_else((int err) -> int {
        return err * 100;
    }), 500);
    g = ok_int(2);
    #assert_eq(g.map_or(0, (int x) -> int {
        return x + 1;
    }), 3);
    h = err_int(5);
    #assert_eq(h.map_or(0, (int x) -> int {
        return x + 1;
    }), 0)
}

#[test]
fn test_option_unwrap_expect() {
    a = some_int(3);
    #assert_eq(a.unwrap(), 3);
    b = some_int(4);
    #assert_eq(b.expect("should have value"), 4)
}

#[should_panic]
fn test_option_unwrap_none_panics() {
    a = none_int();
    x = a.unwrap();
}

#[should_panic]
fn test_option_expect_none_panics() {
    a = none_int();
    x = a.expect("custom message");
}

#[test]
fn test_result_unwrap_expect() {
    r = ok_int(5);
    #assert_eq(r.unwrap(), 5);
    s = ok_int(6);
    #assert_eq(s.expect("should be ok"), 6)
}

#[should_panic]
fn test_result_unwrap_err_panics() {
    e = err_int(9);
    x = e.unwrap();
}

#[should_panic]
fn test_result_expect_err_panics() {
    e = err_int(9);
    x = e.expect("custom message");
}
