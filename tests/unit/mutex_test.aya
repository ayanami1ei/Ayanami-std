import "sync";

import "thread";

import "test";

#[test]
fn test_mutex_single_thread() {
    m = Mutex::new[int](41);
    m.with_lock((ref mut int v) -> void { *v = *v + 1 });
    r = m.with_lock((ref mut int v) -> int { *v });
    #assert_eq(r, 42)
}

#[test]
fn test_mutex_explicit_lock_unlock() {
    m = Mutex::new[int](3);
    m.lock();
    m.unlock();
    r = m.with_lock((ref mut int v) -> int { *v });
    #assert_eq(r, 3)
}

#[test]
fn test_mutex_string_payload() {
    // 拥有型载荷：替换后旧值 drop（泄漏由 mem 门禁间接覆盖）
    m = Mutex::new[String]("hello");
    m.with_lock((ref mut String s) -> void { *s = "world" });
    n = m.with_lock((ref mut String s) -> int { (*s).len() as int });
    #assert_eq(n, 5)
}

#[test]
fn test_mutex_contention() {
    // 8 线程并发争用（futex 等待/唤醒路径）
    m = Mutex::new[int](0);
    done = AtomicInt::new(0);
    n = 8;
    unsafe {
        pm = ref m as *Mutex[int]
        pd = ref done as *AtomicInt
        i = 0;
        while i < n {
            Thread::spawn(() -> void {
                unsafe {
                    (*pm).with_lock((ref mut int v) -> void { *v = *v + 1 });
                    (*pd).fetch_add(1)
                }
            })
            i = i + 1
        }
        while done.load() < n {
            cpu_relax()
        }
    }
    total = m.with_lock((ref mut int v) -> int { *v });
    #assert_eq(total, n)
}
