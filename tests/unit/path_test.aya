import "path";

import "test";

#[test]
fn test_path_normalize() {
    #assert_eq(normalize(""), "");
    #assert_eq(normalize("/"), "/");
    #assert_eq(normalize("a//b///c"), "a/b/c");
    #assert_eq(normalize("/a/b/"), "/a/b");
    #assert_eq(normalize("a/b/"), "a/b")
}

#[test]
fn test_path_join() {
    #assert_eq(join("a", "b"), "a/b");
    #assert_eq(join("a/", "b"), "a/b");
    #assert_eq(join("a", "/b"), "/b");
    #assert_eq(join("", "b"), "b");
    #assert_eq(join("a", ""), "a");
    #assert_eq(join("/", "b"), "/b");
    #assert_eq(join("a", "../b"), "a/../b")
}

#[test]
fn test_path_basename_dirname() {
    #assert_eq(basename("/a/b/c.txt"), "c.txt");
    #assert_eq(basename("c.txt"), "c.txt");
    #assert_eq(basename("/"), "/");
    #assert_eq(dirname("/a/b/c.txt"), "/a/b");
    #assert_eq(dirname("c.txt"), ".");
    #assert_eq(dirname("/c.txt"), "/");
    #assert_eq(dirname("/"), "/")
}

#[test]
fn test_path_extension() {
    #assert_eq(extension("a/b/c.txt"), "txt");
    #assert_eq(extension("a/b/c"), "");
    #assert_eq(extension("archive.tar.gz"), "gz");
    #assert_eq(extension("/"), "")
}

#[test]
fn test_path_absolute_stem_extension() {
    #assert(is_absolute("/a/b"));
    #assert(!is_absolute("a/b"));
    #assert_eq(file_stem("a/b/c.txt"), "c");
    #assert_eq(file_stem("archive.tar.gz"), "archive.tar");
    #assert_eq(file_stem(".bashrc"), ".bashrc");
    #assert_eq(file_stem("noext"), "noext");
    #assert_eq(extension(".bashrc"), "");
    #assert_eq(with_extension("/a/b/c.txt", "md"), "/a/b/c.md");
    #assert_eq(with_extension("c.txt", ""), "c");
    #assert_eq(with_extension("c", "md"), "c.md");
    #assert_eq(with_extension("/c", "md"), "/c.md");
    #assert_eq(with_extension(".bashrc", "md"), ".bashrc.md")
}
