import "hashset"
import "test"

#[test]
fn test_set_basic() {
    s = HashSet::new[String]()
    #assert(s.insert("apple"))
    #assert(!s.insert("apple"))
    #assert_eq(s.len(), 1)
    #assert(s.contains("apple"))
    #assert(!s.contains("banana"))
    s.insert("banana")
    #assert_eq(s.len(), 2)
    #assert(s.remove("apple"))
    #assert(!s.contains("apple"))
    #assert_eq(s.len(), 1)
    #assert(!s.remove("nope"))
}

#[test]
fn test_set_grow() {
    s = HashSet::new[String]()
    i = 0
    while i < 200 {
        j = i * 7
        s.insert(j.to_string())
        i = i + 1
    }
    #assert_eq(s.len(), 200)
    #assert(s.contains("0"))
    #assert(s.contains("1393"))
    #assert(!s.contains("999"))
}

#[test]
fn test_set_tombstone() {
    s = HashSet::new[int]()
    i = 0
    while i < 8 {
        s.insert(i)
        i = i + 1
    }
    i = 0
    while i < 8 {
        s.remove(i)
        i = i + 2
    }
    #assert_eq(s.len(), 4)
    i = 0
    while i < 8 {
        if i % 2 == 0 {
            #assert(!s.contains(i))
        } else {
            #assert(s.contains(i))
        }
        i = i + 1
    }
    i = 8
    while i < 20 {
        s.insert(i)
        i = i + 1
    }
    #assert_eq(s.len(), 16)
    #assert(s.contains(19))
    #assert(!s.contains(0))
}

#[test]
fn test_to_list() {
    s = HashSet::new[String]()
    s.insert("x")
    s.insert("y")
    l = s.to_list()
    #assert_eq(l.len(), 2)
    #assert(l.contains("x"))
    #assert(l.contains("y"))
}

#[test]
fn test_set_to_string() {
    s = HashSet::new[String]()
    s.insert("x")
    s.insert("y")
    t = s.to_string()
    #assert(t.starts_with("{"))
    #assert(t.contains("x"))
    #assert(t.contains("y"))
    e = HashSet::new[String]()
    #assert_eq(e.to_string(), "{}")
}

#[test]
fn test_set_fold() {
    s = HashSet::new[int]()
    s.insert(1)
    s.insert(2)
    total = s.fold(0, (int acc, int k) -> int { return acc + k })
    #assert_eq(total, 3)
}

#[test]
fn test_set_retain() {
    s = HashSet::new[int]()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    s.retain((int k) -> bool { return k != 2 })
    #assert_eq(s.len(), 2)
    #assert(!s.contains(2))
    #assert(s.contains(1))
    #assert(s.contains(3))
}

#[test]
fn test_set_ops() {
    a = HashSet::new[int]()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    b = HashSet::new[int]()
    b.insert(2)
    b.insert(3)
    b.insert(4)
    u = a.union(b)
    #assert_eq(u.len(), 4)
    #assert(u.contains(1))
    #assert(u.contains(4))
    i = a.intersection(b)
    #assert_eq(i.len(), 2)
    #assert(i.contains(2))
    #assert(i.contains(3))
    d = a.difference(b)
    #assert_eq(d.len(), 1)
    #assert(d.contains(1))
    #assert(!d.contains(2))
}

#[test]
fn test_set_into_iter() {
    s = HashSet::new[int]()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    n = 0
    for k in s.into_iter() {
        n = n + k
    }
    #assert_eq(n, 6)
}
