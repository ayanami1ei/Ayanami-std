import "convert"
import "std"
import "test"

fn as_float[U: Into[float]](U x) -> float {
    return x.into()
}

#[test]
fn test_parse_int() -> int {
    #assert_eq(parse_int_or("123", 0), 123)
    #assert_eq(parse_int_or("-45", 0), -45)
    #assert_eq(parse_int_or("+7", 0), 7)
    #assert_eq(parse_int_or(" 1", -1), -1)
    #assert_eq(parse_int_or("1 ", -1), -1)
    #assert_eq(parse_int_or("12a", -1), -1)
    #assert_eq(parse_int_or("", -1), -1)
    #assert_eq(parse_int_or("+", -1), -1)
    #assert_eq(parse_int_or("99999999999999999999", -1), -1)
    return 0
}

#[test]
fn test_parse_float() -> int {
    #assert_eq(parse_float_or("1.5", 0.0), 1.5)
    #assert_eq(parse_float_or("-0.25", 0.0), 0.0 - 0.25)
    #assert_eq(parse_float_or("2", 0.0), 2.0)
    #assert_eq(parse_float_or(".5", 0.0), 0.5)
    #assert_eq(parse_float_or("1.", 0.0), 1.0)
    #assert_eq(parse_float_or("x", 0.0 - 1.0), 0.0 - 1.0)
    #assert_eq(parse_float_or("1.2.3", 0.0 - 1.0), 0.0 - 1.0)
    #assert_eq("2.5".parse_float(), 2.5)
    #assert_eq("x".parse_float(), 0.0)
    return 0
}

#[test]
fn test_parse_bool() -> int {
    #assert_eq(parse_bool_or("true", false), true)
    #assert_eq(parse_bool_or("false", true), false)
    #assert_eq(parse_bool_or("yes", true), true)
    #assert_eq(parse_bool_or("TRUE", true), true)
    return 0
}

#[test]
fn test_convert() -> int {
    #assert_eq(3.to_float(), 3.0)
    #assert_eq(3.9.to_int(), 3)
    n = 0.0 - 3.9
    #assert_eq(n.to_int(), -3)
    #assert_eq('A'.to_int(), 65)
    #assert_eq(65.to_char(), 'A')
    #assert_eq(true.to_int(), 1)
    #assert_eq(false.to_int(), 0)
    f = 3.into()
    #assert_eq(f, 3.0)
    #assert_eq('A'.into(), 65)
    #assert_eq(true.into(), 1)
    #assert_eq(as_float(3), 3.0)
    return 0
}
