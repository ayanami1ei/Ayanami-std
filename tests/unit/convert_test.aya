import "convert"
import "std"
import "test"

fn as_float[U: Into[float]](U x) -> float {
    return x.into()
}

#[test]
fn test_parse_int() {
    #assert_eq("123".try_parse_int().unwrap_or(0), 123)
    #assert_eq("-45".try_parse_int().unwrap_or(0), -45)
    #assert_eq("+7".try_parse_int().unwrap_or(0), 7)
    #assert(" 1".try_parse_int().is_none())
    #assert("1 ".try_parse_int().is_none())
    #assert("12a".try_parse_int().is_none())
    #assert("".try_parse_int().is_none())
    #assert("+".try_parse_int().is_none())
    #assert("99999999999999999999".try_parse_int().is_none())
    #assert_eq(parse_int_or("123", 0), 123)
}

#[test]
fn test_parse_float() {
    #assert_eq("1.5".try_parse_float().unwrap_or(0.0), 1.5)
    #assert_eq("-0.25".try_parse_float().unwrap_or(0.0), 0.0 - 0.25)
    #assert_eq("2".try_parse_float().unwrap_or(0.0), 2.0)
    #assert_eq(".5".try_parse_float().unwrap_or(0.0), 0.5)
    #assert_eq("1.".try_parse_float().unwrap_or(0.0), 1.0)
    #assert("x".try_parse_float().is_none())
    #assert("1.2.3".try_parse_float().is_none())
    #assert_eq("2.5".parse_float(), 2.5)
    #assert_eq("x".parse_float(), 0.0)
    #assert_eq(parse_float_or("1.5", 0.0), 1.5)
}

#[test]
fn test_parse_bool() {
    #assert_eq("true".try_parse_bool().unwrap_or(true), true)
    #assert_eq("false".try_parse_bool().unwrap_or(true), false)
    #assert("yes".try_parse_bool().is_none())
    #assert("TRUE".try_parse_bool().is_none())
    #assert_eq(parse_bool_or("true", false), true)
}

#[test]
fn test_convert() {
    #assert_eq(3.to_float(), 3.0)
    #assert_eq(3.9.to_int(), 3)
    n = 0.0 - 3.9
    #assert_eq(n.to_int(), -3)
    #assert_eq('A'.to_int(), 65)
    #assert_eq(65.to_char(), 'A')
    #assert_eq(true.to_int(), 1)
    #assert_eq(false.to_int(), 0)
    f = 3.into()
    #assert_eq(f, 3.0)
    #assert_eq('A'.into(), 65)
    #assert_eq(true.into(), 1)
    #assert_eq(as_float(3), 3.0)
}
