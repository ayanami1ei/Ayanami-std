import "bitops";

import "test";

#[test]
fn test_popcount() {
    #assert_eq(popcount(0), 0);
    #assert_eq(popcount(1), 1);
    #assert_eq(popcount(7), 3);
    #assert_eq(popcount(255), 8)
}

#[test]
fn test_zeros() {
    #assert_eq(leading_zeros(0), 64);
    #assert_eq(trailing_zeros(0), 64);
    #assert_eq(trailing_zeros(8), 3);
    #assert_eq(leading_zeros(1), 63);
    x = 0 - 1;
    #assert_eq(leading_zeros(x), 0)
}

#[test]
fn test_power_of_two() {
    #assert(is_power_of_two(1));
    #assert(is_power_of_two(2));
    #assert(is_power_of_two(1024));
    #assert(!is_power_of_two(0));
    #assert(!is_power_of_two(3));
    #assert(!is_power_of_two(0 - 2))
}

#[test]
fn test_bitops_rotate() {
    #assert_eq(rotl(1, 1), 2);
    #assert_eq(rotr(2, 1), 1);
    #assert_eq(rotl(1, 63), 0 - 9223372036854775807 - 1);
    #assert_eq(rotr(0 - 9223372036854775807 - 1, 1), 4611686018427387904);
    #assert_eq(rotl(5, 64), 5);
    #assert_eq(rotr(5, 0), 5)
}

#[test]
fn test_bitops_length_reverse_swap() {
    #assert_eq(bit_length(0), 0);
    #assert_eq(bit_length(1), 1);
    #assert_eq(bit_length(255), 8);
    #assert_eq(bit_length(256), 9);
    #assert_eq(reverse_bits(1), 0 - 9223372036854775807 - 1);
    #assert_eq(reverse_bits(reverse_bits(12345)), 12345);
    #assert_eq(swap_bytes(1234605616436508424), 610068790934446609);
    #assert_eq(swap_bytes(swap_bytes(42)), 42)
}

#[test]
fn test_bitops_next_power() {
    #assert_eq(next_power_of_two(0), 1);
    #assert_eq(next_power_of_two(1), 1);
    #assert_eq(next_power_of_two(2), 2);
    #assert_eq(next_power_of_two(3), 4);
    #assert_eq(next_power_of_two(1000), 1024)
}
