import "process";

import "fs";

import "test";

#[test]
fn test_process_id() {
    p = id();
    #assert(p > 0);
    #assert(parent_id() > 0);
    #assert(parent_id() != p)
}

#[test]
fn test_process_run() {
    #assert_eq(run("exit 0"), 0);
    #assert_eq(run("exit 7"), 7);
    #assert_eq(run("true"), 0);
    #assert_eq(run("false"), 1);
    #assert_eq(run("echo hi > /tmp/ayanami_run_test.txt"), 0);
    #assert_eq(read_file("/tmp/ayanami_run_test.txt").unwrap(), "hi\n");
    remove_file("/tmp/ayanami_run_test.txt");
    #assert_eq(run("kill -TERM $$"), 143)
}

#[test]
fn test_process_output() {
    #assert_eq(output("echo hi").unwrap(), "hi\n");
    #assert_eq(output("printf abc").unwrap(), "abc");
    big = output("yes a | head -n 5000").unwrap();
    #assert_eq(big.len(), 10000usize);
    #assert_eq(output("exit 3").unwrap(), "")
}
