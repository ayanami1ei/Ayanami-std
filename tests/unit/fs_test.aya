import "fs";

import "time";

import "arraylist";

import "test";

#[test]
fn test_roundtrip() {
    #assert(write_file("/tmp/ayanami_fs_test.txt", "hello fs"));
    #assert(exists("/tmp/ayanami_fs_test.txt"));
    s = read_file("/tmp/ayanami_fs_test.txt").unwrap_or("");
    #assert_eq(s, "hello fs")
}

#[test]
fn test_missing() {
    #assert(!exists("/tmp/ayanami_no_such_file_xyz"));
    #assert(read_file("/tmp/ayanami_no_such_file_xyz").is_none())
}

#[test]
fn test_read_lines() {
    #assert(write_file("/tmp/ayanami_fs_lines_test.txt", "a\r\nb\nc"));
    empty = ArrayList::new[String]();
    ls = read_lines("/tmp/ayanami_fs_lines_test.txt").unwrap_or(empty);
    #assert_eq(ls.len(), 3);
    #assert_eq(ls.index(0), "a");
    #assert_eq(ls.index(1), "b");
    #assert_eq(ls.index(2), "c");
    #assert(read_lines("/tmp/ayanami_no_such_file_xyz").is_none())
}

#[test]
fn test_append() {
    #assert(write_file("/tmp/ayanami_fs_append_test.txt", "a"));
    #assert(append_file("/tmp/ayanami_fs_append_test.txt", "bc"));
    s = read_file("/tmp/ayanami_fs_append_test.txt").unwrap_or("");
    #assert_eq(s, "abc")
}

#[test]
fn test_remove() {
    #assert(write_file("/tmp/ayanami_fs_remove_test.txt", "x"));
    #assert(exists("/tmp/ayanami_fs_remove_test.txt"));
    #assert(remove_file("/tmp/ayanami_fs_remove_test.txt"));
    #assert(!exists("/tmp/ayanami_fs_remove_test.txt"));
    #assert(!remove_file("/tmp/ayanami_fs_no_such_file_xyz"))
}

#[test]
fn test_dir_ops() {
    #assert(is_dir("/tmp"));
    #assert(!is_dir("/tmp/ayanami_no_such_file_xyz"));
    #assert(write_file("/tmp/ayanami_fs_dir_test.txt", "x"));
    o = list_dir("/tmp");
    if o._tag != 0 {
        return;
    }
    entries = o._data_Some._0;
    #assert(entries.contains("ayanami_fs_dir_test.txt"));
    #assert(remove_file("/tmp/ayanami_fs_dir_test.txt"));
    #assert(list_dir("/tmp/ayanami_no_such_file_xyz").is_none())
}

#[test]
fn test_fs_more() {
    d = "/tmp/ayanami_fs_mkdir_" + now_millis().to_string();
    #assert(mkdir(d.copy()));
    #assert(is_dir(d.copy()));
    #assert(write_file(d + "/f.txt", "x"));
    #assert(is_file(d + "/f.txt"));
    #assert(mtime(d + "/f.txt").unwrap_or(-1) > 0);
    #assert(!is_file(d.copy()));
    #assert(remove_file(d + "/f.txt"));
    #assert(rmdir(d.copy()));
    #assert(!is_dir(d.copy()));
    #assert(mtime("/tmp/ayanami_no_such_file_xyz").is_none());
    #assert(!mkdir("/tmp/ayanami_no_such_dir_xyz/sub"))
}

#[test]
fn test_copy_rename() {
    #assert(write_file("/tmp/ayanami_fs_cr_src.txt", "hello"));
    #assert(copy_file("/tmp/ayanami_fs_cr_src.txt", "/tmp/ayanami_fs_cr_dst.txt"));
    v = read_file("/tmp/ayanami_fs_cr_dst.txt").unwrap_or("");
    #assert_eq(v, "hello");
    #assert(rename_file("/tmp/ayanami_fs_cr_dst.txt", "/tmp/ayanami_fs_cr_dst2.txt"));
    #assert(!exists("/tmp/ayanami_fs_cr_dst.txt"));
    v2 = read_file("/tmp/ayanami_fs_cr_dst2.txt").unwrap_or("");
    #assert_eq(v2, "hello");
    #assert(remove_file("/tmp/ayanami_fs_cr_src.txt"));
    #assert(remove_file("/tmp/ayanami_fs_cr_dst2.txt"));
    #assert(!copy_file("/tmp/ayanami_no_such_file_xyz", "/tmp/ayanami_fs_cr_dst.txt"))
}

#[test]
fn test_size_copy_tree() {
    base = "/tmp/ayanami_fs_tree_" + now_millis().to_string();
    src = base + "/src";
    dst = base + "/dst";
    #assert(mkdir(base.copy()));
    #assert(mkdir(src.copy()));
    #assert(mkdir(src + "/sub"));
    #assert(write_file(src + "/a.txt", "hello"));
    #assert(write_file(src + "/sub/b.txt", "xy"));
    #assert_eq(size(src + "/a.txt").unwrap_or(-1), 5);
    n = copy_tree(src.copy(), dst.copy());
    #assert_eq(n, 2);
    v = read_file(dst + "/sub/b.txt").unwrap_or("");
    #assert_eq(v, "xy");
    #assert(size("/tmp/ayanami_no_such_file_xyz").is_none());
    #assert(remove_file(src + "/a.txt"));
    #assert(remove_file(src + "/sub/b.txt"));
    #assert(remove_file(dst + "/a.txt"));
    #assert(remove_file(dst + "/sub/b.txt"));
    #assert(rmdir(src + "/sub"));
    #assert(rmdir(dst + "/sub"));
    #assert(rmdir(src.copy()));
    #assert(rmdir(dst.copy()));
    #assert(rmdir(base.copy()))
}

#[test]
fn test_error_model() {
    r = read_file_result("/tmp/ayanami_no_such_file_xyz");
    #assert(r.is_err());
    e = last_error("/tmp/ayanami_no_such_file_xyz");
    #assert_eq(e.errno, 2);
    #assert(e.what().contains("ayanami_no_such_file_xyz"));
    #assert(e.what().contains("No such file"));
    #assert(write_file("/tmp/ayanami_fs_err_test.txt", "ok"));
    r2 = read_file_result("/tmp/ayanami_fs_err_test.txt");
    #assert(r2.is_ok());
    r3 = read_file_result("/tmp/ayanami_fs_err_test.txt");
    #assert_eq(r3.unwrap_or(""), "ok");
    #assert(mkdir("/tmp/ayanami_fs_err_dir"));
    #assert(!mkdir("/tmp/ayanami_fs_err_dir"));
    e2 = last_error("/tmp/ayanami_fs_err_dir");
    #assert_eq(e2.errno, 17);
    #assert(!write_file("/tmp/ayanami_no_dir_xyz/f.txt", "x"));
    e3 = last_error("/tmp/ayanami_no_dir_xyz/f.txt");
    #assert_eq(e3.errno, 2);
    #assert(rmdir("/tmp/ayanami_fs_err_dir"));
    #assert(remove_file("/tmp/ayanami_fs_err_test.txt"))
}

#[test]
fn test_fs_walk() {
    root = "/tmp/ayanami_walk_test";
    sub = join(root.copy(), "sub");
    mkdir(root.copy());
    mkdir(sub.copy());
    write_file(join(root.copy(), "a.txt"), "a");
    write_file(join(sub.copy(), "b.txt"), "b");
    files = walk(root.copy());
    #assert(files.len() >= 2);
    #assert(files.contains(join(root.copy(), "a.txt")));
    #assert(files.contains(join(sub.copy(), "b.txt")));
    remove_file(join(root.copy(), "a.txt"));
    remove_file(join(sub.copy(), "b.txt"));
    rmdir(sub.copy());
    rmdir(root)
}

#[test]
fn test_fs_walk_filtered_and_ext() {
    root = "/tmp/ayanami_walk_filter_test";
    sub = join(root.copy(), "sub");
    mkdir(root.copy());
    mkdir(sub.copy());
    write_file(join(root.copy(), "a.txt"), "a");
    write_file(join(root.copy(), "b.log"), "b");
    write_file(join(sub.copy(), "c.txt"), "c");
    txt = walk_filtered(root.copy(), (ref String p) -> bool {
        return p.ends_with(".txt");
    });
    #assert_eq(txt.len(), 2);
    #assert(txt.contains(join(root.copy(), "a.txt")));
    #assert(txt.contains(join(sub.copy(), "c.txt")));
    logs = walk_ext(root.copy(), ".log");
    #assert_eq(logs.len(), 1);
    #assert(logs.contains(join(root.copy(), "b.log")));
    remove_file(join(root.copy(), "a.txt"));
    remove_file(join(root.copy(), "b.log"));
    remove_file(join(sub.copy(), "c.txt"));
    rmdir(sub.copy());
    rmdir(root)
}

#[test]
fn test_fs_current_dir() {
    d = current_dir().unwrap();
    #assert(d.len() > 0);
    #assert(d.starts_with("/"));
    #assert(exists(d.copy()))
}

#[test]
fn test_fs_read_link_and_canonicalize() {
    root = "/tmp/ayanami_link_test";
    sub = join(root.copy(), "sub");
    mkdir(root.copy());
    mkdir(sub.copy());
    target = join(sub.copy(), "target.txt");
    write_file(target.copy(), "x");
    rel_link = join(root.copy(), "rel.txt");
    abs_link = join(root.copy(), "abs.txt");
    #assert(symlink("sub/target.txt", rel_link.copy()));
    #assert(symlink(target.copy(), abs_link.copy()));
    #assert_eq(read_link(rel_link.copy()).unwrap(), "sub/target.txt");
    #assert_eq(read_link(abs_link.copy()).unwrap(), target);
    #assert_eq(canonicalize(rel_link.copy()).unwrap(), target);
    #assert_eq(canonicalize(abs_link.copy()).unwrap(), target);
    loop_a = join(root.copy(), "a");
    loop_b = join(root.copy(), "b");
    #assert(symlink("b", loop_a.copy()));
    #assert(symlink("a", loop_b.copy()));
    #assert(canonicalize(loop_a.copy()).is_none());
    #assert_eq(canonicalize(join(root.copy(), "sub/../sub/./target.txt")).unwrap(), target);
    #assert(read_link(target.copy()).is_none());
    remove_file(rel_link.copy());
    remove_file(abs_link.copy());
    remove_file(loop_a.copy());
    remove_file(loop_b.copy());
    remove_file(target.copy());
    rmdir(sub.copy());
    rmdir(root)
}
