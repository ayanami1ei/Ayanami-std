#[test]
fn test_roundtrip() {
    #assert(write_file("/tmp/ayanami_fs_test.txt", "hello fs"))
    #assert(exists("/tmp/ayanami_fs_test.txt"))
    s = read_file("/tmp/ayanami_fs_test.txt").unwrap_or("")
    #assert_eq(s, "hello fs")
}

