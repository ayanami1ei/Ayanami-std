import "fs"
import "arraylist"
import "test"

#[test]
fn test_roundtrip() {
    path = "/tmp/ayanami_fs_test.txt"
    #assert(write_file(path, "hello fs"))
    #assert(exists(path))
    s = read_file(path).unwrap_or("")
    #assert_eq(s, "hello fs")
}

#[test]
fn test_missing() {
    #assert(!exists("/tmp/ayanami_no_such_file_xyz"))
    #assert(read_file("/tmp/ayanami_no_such_file_xyz").is_none())
}

#[test]
fn test_read_lines() {
    path = "/tmp/ayanami_fs_lines_test.txt"
    #assert(write_file(path, "a\r\nb\nc"))
    empty = ArrayList::new[String]()
    ls = read_lines(path).unwrap_or(empty)
    #assert_eq(ls.len(), 3)
    #assert_eq(ls.index(0), "a")
    #assert_eq(ls.index(1), "b")
    #assert_eq(ls.index(2), "c")
    #assert(read_lines("/tmp/ayanami_no_such_file_xyz").is_none())
}
