import "test"
import "text"

#[test]
fn test_split() {
    parts = split("a,b,c", ",")
    #assert_eq(parts.len(), 3)
    #assert_eq(parts.index(0), "a")
    #assert_eq(parts.index(2), "c")
    p2 = split("a::b::c", "::")
    #assert_eq(p2.len(), 3)
    #assert_eq(p2.index(1), "b")
    p3 = split("abc", ",")
    #assert_eq(p3.len(), 1)
    #assert_eq(p3.index(0), "abc")
}

#[test]
fn test_join() {
    l = ArrayList::new[String]()
    l.push("a")
    l.push("b")
    l.push("c")
    #assert_eq(join(l, "-"), "a-b-c")
    empty = ArrayList::new[String]()
    #assert_eq(join(empty, ","), "")
}

#[test]
fn test_replace() {
    #assert_eq(replace("a-b-c", "-", "+"), "a+b+c")
    #assert_eq(replace("abc", "x", "y"), "abc")
    #assert_eq(replace("aXXbXXc", "XX", "-"), "a-b-c")
    #assert_eq(replace("abc", "", "-"), "abc")
}

#[test]
fn test_pad() {
    #assert_eq(pad_left("42", 5, '0'), "00042")
    #assert_eq(pad_right("42", 5, '.'), "42...")
    #assert_eq(pad_left("abcdef", 3, '0'), "abcdef")
}

#[test]
fn test_lines() {
    ls = lines("a\nb\nc")
    #assert_eq(ls.len(), 3)
    #assert_eq(ls.index(0), "a")
    #assert_eq(ls.index(2), "c")
    crlf = lines("a\r\nb\r\n")
    #assert_eq(crlf.len(), 2)
    #assert_eq(crlf.index(0), "a")
    #assert_eq(crlf.index(1), "b")
    empty = lines("")
    #assert_eq(empty.len(), 0)
    one = lines("x")
    #assert_eq(one.len(), 1)
    #assert_eq(one.index(0), "x")
}

#[test]
fn test_split_once() {
    r = split_once("a=b=c", "=")
    #assert(r.found)
    #assert_eq(r.before, "a")
    #assert_eq(r.after, "b=c")
    r2 = split_once("abc", ",")
    #assert(!r2.found)
    #assert_eq(r2.before, "abc")
    #assert(r2.after.is_empty())
    r3 = split_once("=x", "=")
    #assert(r3.found)
    #assert(r3.before.is_empty())
    #assert_eq(r3.after, "x")
}

#[test]
fn test_split_whitespace() {
    w = split_whitespace("  a  b\tc\nd ")
    #assert_eq(w.len(), 4)
    #assert_eq(w.index(0), "a")
    #assert_eq(w.index(1), "b")
    #assert_eq(w.index(2), "c")
    #assert_eq(w.index(3), "d")
    e = split_whitespace("   ")
    #assert_eq(e.len(), 0)
}

#[test]
fn test_count() {
    #assert_eq(count("banana", "an"), 2)
    #assert_eq(count("aaaa", "aa"), 2)
    #assert_eq(count("abc", "x"), 0)
    #assert_eq(count("abc", ""), 0)
}
