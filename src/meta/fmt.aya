import "arraylist";

import "iter";

import "macros";

import "string";

// fmt — 编译期格式化宏
//
//   #format("x={} y={}", 1, 2)   →  "x=1 y=2"
//
// 约定：
// - 每个 `{}` 按顺序消费一个参数（调用其 `ToString::to_string()`）；
// - `{{` / `}}` 输出字面量花括号；
// - 占位符个数与参数个数不一致 → 编译错误。
//
// 实现：宏参数 `input` 是实参的 token 流（#217），`to_source` 取原文后按顶层逗号
// 切分；首个参数须为字符串字面量。展开结果必须是 token 流（`to_bytes`）：
// 字面量片段用 `push_literal` 重新加引号，参数表达式用 `from_bytes` + `append` 嵌入。

#[alloc]
#[state]
fn push_char(String s, char c) -> String {
    return s + c.to_string();
}

#[alloc]
#[state]
fn trim_ws(String s) -> String {
    start = 0;
    n = s.len() as int;
    while start < n {
        c = s[start];
        if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
            break
        }
        start = start + 1
    }
    end = n;
    while end > start {
        c = s[end - 1];
        if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
            break
        }
        end = end - 1
    }
    return s.substring(start as usize, end as usize)
}

/// 顶层逗号切分（忽略字符串内与括号/方括号/花括号内的逗号）
#[alloc]
#[state]
fn split_top(String s) -> ArrayList[String] {
    parts = ArrayList::new[String]();
    cur = "";
    depth = 0;
    in_str = false;
    esc = false;
    i = 0;
    n = s.len() as int;
    while i < n {
        c = s[i];
        if in_str {
            cur = push_char(cur, c);
            if esc {
                esc = false
            } else {
                if c == '\\' {
                    esc = true
                } else {
                    if c == '"' {
                        in_str = false
                    }
                }
            }
        } else {
            if c == '"' {
                in_str = true;
                cur = push_char(cur, c)
            } else {
                if c == '(' || c == '[' || c == '{' {
                    depth = depth + 1;
                    cur = push_char(cur, c)
                } else {
                    if c == ')' || c == ']' || c == '}' {
                        depth = depth - 1;
                        cur = push_char(cur, c)
                    } else {
                        if c == ',' && depth == 0 {
                            parts.push(cur);
                            cur = ""
                        } else {
                            cur = push_char(cur, c)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    parts.push(cur);
    return parts
}

/// `#format("...", args...)`：展开为字符串拼接表达式（文本宏：输入输出均为源码）
#[alloc]
#[state]
#[macro]
pub fn format(String input, int __line, int __col, String __file) -> String {
    parts = split_top(input);
    lit = trim_ws(parts[0]);
    if lit.len() < 2 || lit[0] != '"' {
        diag_error("format: 首个参数必须是字符串字面量");
        return "\"\""
    }
    inner = lit.substring(1usize, lit.len() - 1usize);
    res = "";
    first = true;
    chunk = "";
    used = 0;
    args = parts.len() as int - 1;
    i = 0;
    nn = inner.len() as int;
    while i < nn {
        c = inner[i];
        if c == '{' && i + 1 < nn && inner[i + 1] == '{' {
            chunk = push_char(chunk, '{');
            i = i + 2
        } else {
            if c == '}' && i + 1 < nn && inner[i + 1] == '}' {
                chunk = push_char(chunk, '}');
                i = i + 2
            } else {
                if c == '{' && i + 1 < nn && inner[i + 1] == '}' {
                    if used >= args {
                        diag_error("format: 占位符多于参数");
                        return "\"\""
                    }
                    if chunk.len() > 0 || first {
                        if !first {
                            res = res + " + "
                        }
                        res = res + "\"" + chunk + "\"";
                        first = false;
                        chunk = ""
                    }
                    if !first {
                        res = res + " + "
                    }
                    res = res + "(" + trim_ws(parts[used + 1]) + ").to_string()";
                    first = false;
                    used = used + 1;
                    i = i + 2
                } else {
                    chunk = push_char(chunk, c);
                    i = i + 1
                }
            }
        }
    }
    if used != args {
        diag_error("format: 参数多于占位符");
        return "\"\""
    }
    if chunk.len() > 0 || first {
        if !first {
            res = res + " + "
        }
        res = res + "\"" + chunk + "\""
    }
    return res
}
