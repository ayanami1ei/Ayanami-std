// rand — 伪随机数（纯 Ayanami LCG）
//
// - 确定性：相同种子产生相同序列；非加密用途。
// - 无系统熵源（后续 runtime 扩展可加）；教程可用固定种子或用户输入作种子。
// - 状态保持在 [1, 2^31)，乘法不溢出 i64（无需 wrapping API）。
extern "C" fn __ayanami_random_u64() -> int;

pub struct Rng {
    int state
}

pub namespace Rng {
    /// 用系统熵源创建（非确定性；getrandom / /dev/urandom）
    #[io]
    pub fn from_entropy() -> Rng {
        return Rng::new(__ayanami_random_u64())
    }

    /// 以种子创建（归一化到 [1, 2^31)）
    pub fn new(int seed) -> Rng {
        s = seed % 2147483648
        if s < 0 {
            s = 0 - s
        }
        if s == 0 {
            s = 1
        }
        return Rng { state = s }
    }
}

impl Rng {
    /// 步进并返回新状态（[0, 2^31)）
    #[state]
    pub fn next_int(ref mut self) -> int {
        self.state = (self.state * 1103515245 + 12345) % 2147483648
        return self.state
    }

    /// 返回 [lo, hi) 内的整数（`hi <= lo` 时返回 `lo`）
    #[state]
    pub fn next_range(ref mut self, int lo, int hi) -> int {
        if hi <= lo {
            return lo
        }
        n = hi - lo
        v = self.next_int()
        return lo + (v % n)
    }
}
