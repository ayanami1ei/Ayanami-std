import "string"
import "panic"
import "list"

// 说明：链表曾基于 shared/weak 节点链；新所有权模型暂不支持"借用 unique 字段遍历"，
// 因此改为数组缓冲实现，保持相同的 List 接口（行为等价：顺序表）。
pub struct LinkedList[T] {
    [T] data
    usize len
    usize capability
}

pub namespace LinkedList{
    pub fn new[T]()->LinkedList[T]{
        return LinkedList[T]{data=null, len=0, capability=0}
    }
}

impl[T] LinkedList[T] {
#[alloc]
#[state]
    fn expand(ref mut self){
        if self.capability == 0 {
            self.capability = 1
            self.data = [T; 1]
        } else {
            tmp = [T; self.capability * 2]
            for i in (0, self.len as int) { tmp[i] = self.data[i as usize] }
            self.data = tmp
            self.capability = self.capability * 2
        }
    }

#[alloc]
#[state]
    pub fn push(ref mut self, T val) {
        if self.len + 1 >= self.capability { self.expand() }
        self.data[self.len] = val
        self.len = self.len + 1
    }

    pub fn index(ref self, usize index, int __line, int __col, String __file)->T{
        if index >= self.len { panic_bounds_at(__line, __col, __file, index, self.len) }
        return self.data[index]
    }

    pub fn len(ref self)->usize{ return self.len }

    pub fn iter(ref self, fn(T) f) {
        for i in (0, self.len as int) {
            f(self.data[i as usize])
        }
    }

}

/// 需要元素实现 ToString
impl[T:ToString] LinkedList[T] {
#[alloc]
#[state]
    pub fn to_string(ref self) -> String {
        res = "["
        for i in (0, self.len as int){
            res = res + self.data[i as usize]
            if i != self.len as int - 1 { res = res + ", " }
        }
        res = res + "]"
        return res
    }
}
