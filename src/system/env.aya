// env — 命令行参数与环境变量（运行时提供）
import "string"
import "option"
import "arraylist"

extern "C" fn __ayanami_arg_count() -> int;
extern "C" fn __ayanami_arg_len(int i) -> int;
extern "C" fn __ayanami_arg_data(int i) -> [char];
extern "C" fn __ayanami_env_len(String name) -> int;
extern "C" fn __ayanami_env_data(String name) -> [char];

/// 参数个数（含程序名）
#[io]
pub fn arg_count() -> int {
    return __ayanami_arg_count()
}

/// 第 i 个参数（0 为程序名；越界返回空串）
#[io]
pub fn arg(int i) -> String {
    n = __ayanami_arg_len(i)
    if n < 0 {
        return String::empty()
    }
    data = __ayanami_arg_data(i)
    if data == null {
        return String::empty()
    }
    return String::new(data, n as usize)
}

/// 读取环境变量（缺失 → None）
#[io]
pub fn get_env(String name) -> Option[String] {
    n = __ayanami_env_len(name)
    if n < 0 {
        return Option::None()
    }
    data = __ayanami_env_data(name)
    if data == null {
        return Option::None()
    }
    return Option::Some(String::new(data, n as usize))
}

/// 全部命令行参数（含程序名）
#[alloc]
#[state]
#[io]
pub fn args() -> ArrayList[String] {
    res = ArrayList::new[String]()
    i = 0
    while i < arg_count() {
        res.push(arg(i))
        i = i + 1
    }
    return res
}

/// 读取环境变量，缺失用 fallback
#[alloc]
#[io]
pub fn get_env_or(String name, String fallback) -> String {
    v = get_env(name)
    if v._tag != 0 {
        return fallback
    }
    return v._data_Some._0
}
