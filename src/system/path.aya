import "string";

import "text";

import "iter";

// path — 路径字符串工具（纯字符串运算，不访问文件系统）
//
// 约定：Unix 风格 '/'；空字符串视为空路径；根为 "/"。
// 不解析 ".." / "."（保持字面，交给文件系统）。

/// 规范化：折叠重复 '/'，去掉末尾 '/'（根 "/" 保留）
#[alloc]
#[state]
pub fn normalize(String path) -> String {
    if path.len() == 0 {
        return ""
    }
    sep = "/";
    parts = split(ref path, ref sep);
    res = "";
    for seg in parts.into_iter() {
        if seg.len() > 0 {
            if res.len() > 0 {
                res = res + "/"
            }
            res = res + seg
        }
    }
    slash = "/";
    if path.starts_with(ref slash) {
        res = "/" + res
    }
    return res
}

/// 连接路径：name 为绝对路径时覆盖 base；否则拼接后规范化
#[alloc]
#[state]
pub fn join(String base, String name) -> String {
    slash = "/";
    if name.len() > 0 && name.starts_with(ref slash) {
        return normalize(name)
    }
    if base.len() == 0 {
        return normalize(name)
    }
    if name.len() == 0 {
        return normalize(base)
    }
    return normalize(base + "/" + name)
}

/// 最后一段（空路径 → ""；根 → "/"）
#[alloc]
#[state]
pub fn basename(String path) -> String {
    p = normalize(path);
    if p.len() == 0 {
        return ""
    }
    if p == "/" {
        return "/"
    }
    i = p.len() as int - 1;
    while i >= 0 {
        if p[i] == '/' {
            return p.substring((i + 1) as usize, p.len())
        }
        i = i - 1
    }
    return p
}

/// 目录部分（无目录段 → "."；根 → "/"）
#[alloc]
#[state]
pub fn dirname(String path) -> String {
    p = normalize(path);
    if p.len() == 0 {
        return ""
    }
    if p == "/" {
        return "/"
    }
    i = p.len() as int - 1;
    while i >= 0 {
        if p[i] == '/' {
            if i == 0 {
                return "/"
            }
            return p.substring(0usize, i as usize)
        }
        i = i - 1
    }
    return "."
}

/// 扩展名（无 '.' → ""；不含点本身）
#[alloc]
#[state]
pub fn extension(String path) -> String {
    b = basename(path);
    i = b.len() as int - 1;
    while i >= 0 {
        if b[i] == '.' {
            return b.substring((i + 1) as usize, b.len())
        }
        i = i - 1
    }
    return ""
}
