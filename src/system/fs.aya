// fs — 文件读写（运行时提供）
import "string";

import "path";

import "option";

import "arraylist";

import "text";

#[extern]
fn __ayanami_fs_size(String path) -> int;

#[extern]
fn __ayanami_fs_read(String path) -> [char];

#[extern]
fn __ayanami_fs_write(String path, String data) -> int;

#[extern]
fn __ayanami_fs_append(String path, String data) -> int;

#[extern]
fn __ayanami_fs_remove(String path) -> int;

#[extern]
fn __ayanami_fs_copy(String src, String dst) -> int;

#[extern]
fn __ayanami_fs_rename(String from, String to) -> int;

#[extern]
fn __ayanami_fs_is_dir(String path) -> int;

#[extern]
fn __ayanami_fs_mkdir(String path) -> int;

#[extern]
fn __ayanami_fs_rmdir(String path) -> int;

#[extern]
fn __ayanami_fs_mtime(String path) -> int;

#[extern]
fn __ayanami_fs_is_file(String path) -> int;

#[extern]
fn __ayanami_fs_list_data(String path) -> [char];

#[extern]
fn __ayanami_fs_list_len() -> int;

/// 文件是否存在
#[io]
pub fn exists(String path) -> bool {
    return __ayanami_fs_size(path) >= 0;
}

/// 读取整个文件（失败 None）
#[io]
pub fn read_file(String path) -> Option[String] {
    n = __ayanami_fs_size(path);
    if n < 0 {
        return Option::None();
    }
    data = __ayanami_fs_read(path);
    if data == null {
        return Option::None();
    }
    return Option::Some(String::new(data, n as usize));
}

/// 写入整个文件（成功 true）
#[io]
pub fn write_file(String path, String data) -> bool {
    return __ayanami_fs_write(path, data) == 0;
}

/// 读取文件并按行拆分（`\r\n` 兼容；失败 None）
///
/// 需要空表兜底时用 `read_lines(path).unwrap_or(empty)`。
#[alloc]
#[state]
#[io]
pub fn read_lines(String path) -> Option[ArrayList[String]] {
    data = read_file(path);
    if data._tag != 0 {
        return Option::None();
    }
    ls = lines(data._data_Some._0);
    return Option::Some(ls);
}

/// 追加写入（成功 true；文件不存在则创建）
#[io]
pub fn append_file(String path, String data) -> bool {
    return __ayanami_fs_append(path, data) == 0;
}

/// 删除文件（成功 true）
#[io]
pub fn remove_file(String path) -> bool {
    return __ayanami_fs_remove(path) == 0;
}

/// 是否目录
#[io]
pub fn is_dir(String path) -> bool {
    return __ayanami_fs_is_dir(path) == 1;
}

/// 当前工作目录（失败 None）
#[io]
#[alloc]
#[state]
pub fn current_dir() -> Option[String] {
    data = __ayanami_fs_getcwd();
    if data == null {
        return Option::None();
    }
    n = __ayanami_cstr_len(data);
    return Option::Some(String::new(data, n as usize));
}

/// 创建符号链接（`target` 原样写入；成功 true）
#[io]
pub fn symlink(String target, String link) -> bool {
    return __ayanami_fs_symlink(target, link) == 0;
}

/// 读取符号链接目标（非符号链接或失败 → None）
#[io]
#[alloc]
#[state]
pub fn read_link(String path) -> Option[String] {
    data = __ayanami_fs_read_link(path);
    if data == null {
        return Option::None();
    }
    n = __ayanami_cstr_len(data);
    return Option::Some(String::new(data, n as usize));
}

/// 解析为规范绝对路径（逐段解析符号链接，`.` / `..` 折叠；循环/过深 → None）
///
/// 说明：与 `realpath` 不同，允许末尾不存在的路径段（按字面保留）。
#[io]
#[alloc]
#[state]
pub fn canonicalize(String path) -> Option[String] {
    cur = "";
    if is_absolute(path.copy()) {
        cur = "/";
    } else {
        c = current_dir();
        if c.is_none() {
            return Option::None();
        }
        cur = c.unwrap();
    }
    st = ArrayList::new[String]();
    parts = split(ref path, "/");
    i = parts.len();
    while i > 0 {
        i = i - 1;
        seg = parts.index_ref(i).copy();
        if !seg.is_empty() {
            st.push(seg)
        }
    }
    depth = 0;
    while !st.is_empty() {
        seg = st.pop();
        if seg == "." {} else {
            if seg == ".." {
                cur = dirname(cur.copy());
            } else {
                cand = "";
                if cur == "/" {
                    cand = "/" + seg;
                } else {
                    cand = cur + "/" + seg;
                }
                link = read_link(cand.copy());
                if link.is_some() {
                    depth = depth + 1;
                    if depth > 64 {
                        return Option::None();
                    }
                    target = link.unwrap();
                    if is_absolute(target.copy()) {
                        cur = "/";
                    }
                    tparts = split(ref target, "/");
                    j = tparts.len();
                    while j > 0 {
                        j = j - 1;
                        ts = tparts.index_ref(j).copy();
                        if !ts.is_empty() {
                            st.push(ts)
                        }
                    }
                } else {
                    cur = cand;
                }
            }
        }
    }
    return Option::Some(normalize(cur));
}

/// 目录项（不含 `.` / `..`；失败 None）
#[alloc]
#[state]
#[io]
pub fn list_dir(String path) -> Option[ArrayList[String]] {
    data = __ayanami_fs_list_data(path);
    if data == null {
        return Option::None();
    }
    n = __ayanami_fs_list_len();
    s = String::new(data, n as usize);
    ls = lines(s);
    return Option::Some(ls);
}

/// 创建目录（成功 true）
#[io]
pub fn mkdir(String path) -> bool {
    return __ayanami_fs_mkdir(path) == 0;
}

/// 删除空目录（成功 true）
#[io]
pub fn rmdir(String path) -> bool {
    return __ayanami_fs_rmdir(path) == 0;
}

/// 修改时间（Unix 秒；失败 None）
#[io]
pub fn mtime(String path) -> Option[int] {
    t = __ayanami_fs_mtime(path);
    if t < 0 {
        return Option::None();
    }
    return Option::Some(t);
}

/// 是否普通文件
#[io]
pub fn is_file(String path) -> bool {
    return __ayanami_fs_is_file(path) == 1;
}

/// 复制文件（成功 true；目标存在则覆盖）
#[io]
pub fn copy_file(String src, String dst) -> bool {
    return __ayanami_fs_copy(src, dst) == 0;
}

/// 重命名 / 移动文件（成功 true）
#[io]
pub fn rename_file(String from, String to) -> bool {
    return __ayanami_fs_rename(from, to) == 0;
}

/// 文件字节数（失败 None）
#[io]
pub fn size(String path) -> Option[int] {
    n = __ayanami_fs_size(path);
    if n < 0 {
        return Option::None();
    }
    return Option::Some(n);
}

/// 递归复制目录树（返回复制的文件数；失败 -1；目标目录已存在时合并）
#[alloc]
#[state]
#[io]
pub fn copy_tree(String src, String dst) -> int {
    return copy_tree_impl(src, dst, 16);
}

fn copy_tree_impl(String src, String dst, int depth) -> int {
    if depth <= 0 {
        return 0 - 1;
    }
    if !mkdir(dst.copy()) {
        if !is_dir(dst.copy()) {
            return 0 - 1;
        }
    }
    o = list_dir(src.copy());
    if o._tag != 0 {
        return 0 - 1;
    }
    entries = o._data_Some._0;
    n = 0;
    i = 0usize;
    while i < entries.len() {
        name = entries.index(i);
        s = src + "/" + name;
        d = dst + "/" + name;
        if is_dir(s.copy()) {
            sub = copy_tree_impl(s, d, depth - 1);
            if sub < 0 {
                return 0 - 1;
            }
            n = n + sub;
        } else {
            if copy_file(s, d) {
                n = n + 1;
            } else {
                return 0 - 1;
            }
        }
        i = i + 1;
    }
    return n;
}

// ── 错误模型（errno 捕获 + strerror 消息） ──
#[extern]
fn __ayanami_fs_errno() -> int;

#[extern]
fn __ayanami_fs_errno_kind(int e) -> int;

#[extern]
fn __ayanami_fs_strerror(int e) -> [char];

#[extern]
fn __ayanami_cstr_len([char] s) -> int;

#[extern]
fn __ayanami_fs_getcwd() -> [char];

#[extern]
fn __ayanami_fs_read_link(String path) -> [char];

#[extern]
fn __ayanami_fs_symlink(String target, String link) -> int;

/// IO 错误类别（由 errno 归类）
pub enum IoErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    DirectoryNotEmpty,
    InvalidInput,
    Other,
}

/// IO 错误：类别 + 路径 + errno（`what()` 给出系统消息）
pub struct IoError {
    IoErrorKind kind
    String path
    int errno
}

fn classify_kind(int code) -> IoErrorKind {
    match code {
        0 => IoErrorKind::NotFound,
        1 => IoErrorKind::PermissionDenied,
        2 => IoErrorKind::AlreadyExists,
        3 => IoErrorKind::NotADirectory,
        4 => IoErrorKind::IsADirectory,
        5 => IoErrorKind::DirectoryNotEmpty,
        6 => IoErrorKind::InvalidInput,
        _ => IoErrorKind::Other,
    }
}

impl IoError {
    /// 系统错误消息（strerror + errno 编号）
    #[alloc]
    #[state]
    pub fn message(ref self) -> String {
        p = __ayanami_fs_strerror(self.errno);
        n = __ayanami_cstr_len(p);
        m = String::new(p, n as usize);
        return m + " (errno " + self.errno.to_string() + ")";
    }
    /// 完整消息：`<path>: <message>`（`Error` 接口）
    #[alloc]
    #[state]
    pub fn what(ref self) -> String {
        return self.path + ": " + self.message();
    }
}

/// 最近一次 fs 调用失败的错误详情（仅在失败分支读取有意义）
#[io]
pub fn last_error(String path) -> IoError {
    e = __ayanami_fs_errno();
    return IoError { kind = classify_kind(__ayanami_fs_errno_kind(e)), path = path, errno = e };
}

/// 读取整个文件（失败带错误详情）
#[io]
pub fn read_file_result(String path) -> Result[String, IoError] {
    n = __ayanami_fs_size(path);
    if n < 0 {
        return Result::Err(last_error(path));
    }
    data = __ayanami_fs_read(path);
    if data == null {
        return Result::Err(last_error(path));
    }
    return Result::Ok(String::new(data, n as usize));
}

/// 递归列出目录下所有**文件**路径（深度优先；不含目录本身）
///
/// 顺序取决于 `list_dir`；目录不可读时跳过该分支。
#[alloc]
#[state]
pub fn walk(String root) -> ArrayList[String] {
    res = ArrayList::new[String]();
    walk_into(root, ref mut res);
    return res;
}

#[alloc]
#[state]
fn walk_into(String dir, ref mut ArrayList[String] dst) {
    entries = list_dir(dir.copy());
    match entries {
        Option.Some(names) => {
            for name in names.into_iter() {
                full = join(dir.copy(), name);
                if is_dir(full.copy()) {
                    walk_into(full, dst)
                } else {
                    dst.push(full)
                }
            }
        },
        Option.None => {},
    }
}

/// 递归遍历并按谓词过滤文件路径（谓词收到 `ref` 路径，不转移所有权）
///
/// 用显式目录栈代替递归，闭包只需一份所有权，可安全重复调用。
#[alloc]
#[state]
pub fn walk_filtered(String root, Fn(ref String)->bool keep) -> ArrayList[String] {
    res = ArrayList::new[String]();
    dirs = ArrayList::new[String]();
    dirs.push(root);
    while !dirs.is_empty() {
        dir = dirs.pop();
        entries = list_dir(dir.copy());
        match entries {
            Option.Some(names) => {
                for name in names.into_iter() {
                    full = join(dir.copy(), name);
                    if is_dir(full.copy()) {
                        dirs.push(full)
                    } else {
                        if keep(ref full) {
                            res.push(full)
                        }
                    }
                }
            },
            Option.None => {},
        }
    }
    return res;
}

/// 递归列出指定后缀的文件（`ext` 含点，如 `".txt"`）
#[alloc]
#[state]
pub fn walk_ext(String root, String ext) -> ArrayList[String] {
    all = walk(root);
    res = ArrayList::new[String]();
    for p in all.into_iter() {
        if p.ends_with(ref ext) {
            res.push(p)
        }
    }
    return res;
}
