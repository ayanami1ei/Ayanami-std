// fs — 文件读写（运行时提供）
import "string"
import "option"
import "arraylist"
import "text"

extern "C" fn __ayanami_fs_size(String path) -> int;
extern "C" fn __ayanami_fs_read(String path) -> [char];
extern "C" fn __ayanami_fs_write(String path, String data) -> int;

/// 文件是否存在
#[io]
pub fn exists(String path) -> bool {
    return __ayanami_fs_size(path) >= 0
}

/// 读取整个文件（失败 None）
#[io]
pub fn read_file(String path) -> Option[String] {
    n = __ayanami_fs_size(path)
    if n < 0 {
        return Option::None()
    }
    data = __ayanami_fs_read(path)
    if data == null {
        return Option::None()
    }
    return Option::Some(String::new(data, n as usize))
}

/// 写入整个文件（成功 true）
#[io]
pub fn write_file(String path, String data) -> bool {
    return __ayanami_fs_write(path, data) == 0
}

/// 读取文件并按行拆分（`\r\n` 兼容；失败返回空表）
///
/// 需要区分「失败」与「空文件」时用 `read_file` + `lines`。
/// （`Option[ArrayList[String]]` 版本待 `.unwrap_or` 单态化修复后提供，见 #134；
///   这里不直接调 `ArrayList::new`，规避 .lcl 泛型符号重复定义 #129。）
#[alloc]
#[state]
#[io]
pub fn read_lines(String path) -> ArrayList[String] {
    data = read_file(path)
    if data._tag != 0 {
        return lines("")
    }
    return lines(data._data_Some._0)
}
