// process — 进程控制（当前：退出；参数见 system/env）
#[extern]
fn __ayanami_exit(int code) -> void;

#[extern]
fn __ayanami_process_id() -> int;

#[extern]
fn __ayanami_parent_process_id() -> int;

#[extern]
fn __ayanami_process_run(String command) -> int;

/// 立即退出进程（code 作为退出码；不返回）
#[io]
#[state]
pub fn exit(int code) -> ! {
    __ayanami_exit(code);
    while true {}
}

/// 正常退出（退出码 0）
#[io]
#[state]
pub fn exit_ok() -> ! {
    __ayanami_exit(0);
    while true {}
}

/// 当前进程 ID
#[io]
pub fn id() -> int {
    return __ayanami_process_id();
}

/// 父进程 ID
#[io]
pub fn parent_id() -> int {
    return __ayanami_parent_process_id();
}

/// 通过 `/bin/sh -c` 执行命令并等待结束
///
/// 返回退出码；被信号终止返回 `128 + signal`；无法启动返回 -1。
#[io]
pub fn run(String command) -> int {
    return __ayanami_process_run(command);
}
