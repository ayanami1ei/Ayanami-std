// process — 进程控制（退出 / 进程 ID / 执行命令）
import "string";

import "option";

#[extern]
fn __ayanami_exit(int code) -> void;

#[extern]
fn __ayanami_process_id() -> int;

#[extern]
fn __ayanami_parent_process_id() -> int;

#[extern]
fn __ayanami_process_run(String command) -> int;

#[extern]
fn __ayanami_process_output(String command) -> [char];

#[extern]
fn __ayanami_cstr_len([char] s) -> int;

/// 立即退出进程（code 作为退出码；不返回）
#[io]
#[state]
pub fn exit(int code) -> ! {
    __ayanami_exit(code);
    while true {}
}

/// 正常退出（退出码 0）
#[io]
#[state]
pub fn exit_ok() -> ! {
    __ayanami_exit(0);
    while true {}
}

/// 当前进程 ID
#[io]
pub fn id() -> int {
    return __ayanami_process_id();
}

/// 父进程 ID
#[io]
pub fn parent_id() -> int {
    return __ayanami_parent_process_id();
}

/// 通过 `/bin/sh -c` 执行命令并等待结束
///
/// 返回退出码；被信号终止返回 `128 + signal`；无法启动返回 -1。
#[io]
pub fn run(String command) -> int {
    return __ayanami_process_run(command);
}

/// 执行命令并捕获 stdout（`/bin/sh -c`；失败 → None）
#[io]
#[alloc]
#[state]
pub fn output(String command) -> Option[String] {
    data = __ayanami_process_output(command);
    if data == null {
        return Option::None();
    }
    n = __ayanami_cstr_len(data);
    return Option::Some(String::new(data, n as usize));
}
