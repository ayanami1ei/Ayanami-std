// time — 时间（运行时提供）
//
// - `now_millis()`：单调毫秒（CLOCK_MONOTONIC），适合计时/差值；
// - `now_unix()`：Unix 秒（墙上时钟）。
import "num";

import "string";

import "text";

extern "C" fn __ayanami_time_millis() -> int;

extern "C" fn __ayanami_time_micros() -> int;

extern "C" fn __ayanami_time_unix() -> int;

extern "C" fn __ayanami_time_sleep_ms(int ms);

/// 单调毫秒（计时用）
#[io]
pub fn now_millis() -> int {
    return __ayanami_time_millis();
}

/// 单调微秒（计时用）
#[io]
pub fn now_micros() -> int {
    return __ayanami_time_micros();
}

/// Unix 秒
#[io]
pub fn now_unix() -> int {
    return __ayanami_time_unix();
}

/// 毫秒数格式化：`HH:MM:SS.mmm`（负数取绝对值）
#[alloc]
#[state]
pub fn format_ms(int ms) -> String {
    m = ms;
    if m < 0 {
        m = saturating_neg(m);  // i64::MIN 饱和为 MAX（避免取负溢出）
    }
    h = m / 3600000;
    r = m % 3600000;
    mi = r / 60000;
    r = r % 60000;
    sec = r / 1000;
    mil = r % 1000;
    res = pad_left(h.to_string(), 2usize, '0') + ":";
    res = res + pad_left(mi.to_string(), 2usize, '0') + ":";
    res = res + pad_left(sec.to_string(), 2usize, '0') + ".";
    res = res + pad_left(mil.to_string(), 3usize, '0');
    return res;
}

/// 自 `start`（来自 `now_millis`）起的毫秒差
#[io]
pub fn elapsed_ms(int start) -> int {
    return now_millis() - start;
}

/// 睡眠 `ms` 毫秒（`<= 0` 直接返回）
#[io]
pub fn sleep_ms(int ms) {
    if ms <= 0 {
        return;
    }
    __ayanami_time_sleep_ms(ms)
}
