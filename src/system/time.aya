// time — 时间（运行时提供）
//
// - `now_millis()`：单调毫秒（CLOCK_MONOTONIC），适合计时/差值；
// - `now_unix()`：Unix 秒（墙上时钟）。
import "num";

import "string";

import "text";

#[extern]
fn __ayanami_time_millis() -> int;

#[extern]
fn __ayanami_time_micros() -> int;

#[extern]
fn __ayanami_time_unix() -> int;

#[extern]
fn __ayanami_time_unix_ms() -> int;

#[extern]
fn __ayanami_time_sleep_ms(int ms);

#[extern]
fn __ayanami_time_sleep_us(int us);

/// 单调毫秒（计时用）
#[io]
#[state]
pub fn now_millis() -> int {
    return __ayanami_time_millis();
}

/// 单调微秒（计时用）
#[io]
#[state]
pub fn now_micros() -> int {
    return __ayanami_time_micros();
}

/// Unix 秒
#[io]
#[state]
pub fn now_unix() -> int {
    return __ayanami_time_unix();
}

/// Unix 毫秒（墙上时钟，含毫秒精度）
#[io]
#[state]
pub fn now_unix_ms() -> int {
    return __ayanami_time_unix_ms();
}

/// 睡眠 `us` 微秒（`<= 0` 直接返回）
#[io]
pub fn sleep_us(int us) {
    if us <= 0 {
        return;
    }
    __ayanami_time_sleep_us(us)
}

/// 毫秒数格式化：`HH:MM:SS.mmm`（负数取绝对值）
#[alloc]
#[state]
pub fn format_ms(int ms) -> String {
    m = ms;
    if m < 0 {
        m = saturating_neg(m);  // i64::MIN 饱和为 MAX（避免取负溢出）
    }
    h = m / 3600000;
    r = m % 3600000;
    mi = r / 60000;
    r = r % 60000;
    sec = r / 1000;
    mil = r % 1000;
    res = pad_left(h.to_string(), 2usize, '0') + ":";
    res = res + pad_left(mi.to_string(), 2usize, '0') + ":";
    res = res + pad_left(sec.to_string(), 2usize, '0') + ".";
    res = res + pad_left(mil.to_string(), 3usize, '0');
    return res;
}

/// 自 `start`（来自 `now_millis`）起的毫秒差
#[io]
#[state]
pub fn elapsed_ms(int start) -> int {
    return now_millis() - start;
}

/// 睡眠 `ms` 毫秒（`<= 0` 直接返回）
#[io]
#[state]
pub fn sleep_ms(int ms) {
    if ms <= 0 {
        return;
    }
    __ayanami_time_sleep_ms(ms)
}

// ── Unix 时间分解（UTC，纯 Ayanami） ──
/// 日期时间（UTC）：`weekday` 0=周日 .. 6=周六
pub struct DateTime {
    int year
    int month
    int day
    int hour
    int minute
    int second
    int weekday
}

fn div_floor(int a, int b) -> int {
    q = a / b;
    r = a % b;
    if r != 0 && a < 0 != (b < 0) {
        q = q - 1;
    }
    return q;
}

pub namespace DateTime {
    /// Unix 秒 → UTC 分解（Howard Hinnant civil_from_days）
    pub fn from_unix(int unix) -> DateTime {
        days = div_floor(unix, 86400);
        secs = unix - days * 86400;
        z = days + 719468;
        era = div_floor(z, 146097);
        doe = z - era * 146097;
        yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        y = yoe + era * 400;
        doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        mp = (5 * doy + 2) / 153;
        d = doy - (153 * mp + 2) / 5 + 1;
        m = mp + 3;
        if mp >= 10 {
            m = mp - 9;
        }
        if m <= 2 {
            y = y + 1;
        }
        h = secs / 3600;
        mi = secs % 3600 / 60;
        s = secs % 60;
        wd = ((days + 4) % 7 + 7) % 7;
        return DateTime { year = y, month = m, day = d, hour = h, minute = mi, second = s, weekday = wd };
    }
}

impl DateTime {
    /// `YYYY-MM-DD HH:MM:SS`
    #[alloc]
    #[state]
    pub fn format(ref self) -> String {
        res = pad_left(self.year.to_string(), 4usize, '0') + "-";
        res = res + pad_left(self.month.to_string(), 2usize, '0') + "-";
        res = res + pad_left(self.day.to_string(), 2usize, '0') + " ";
        res = res + pad_left(self.hour.to_string(), 2usize, '0') + ":";
        res = res + pad_left(self.minute.to_string(), 2usize, '0') + ":";
        res = res + pad_left(self.second.to_string(), 2usize, '0');
        return res;
    }
}

/// Unix 秒 → `YYYY-MM-DD HH:MM:SS`（UTC）
#[alloc]
#[state]
pub fn format_unix(int unix) -> String {
    return DateTime::from_unix(unix).format();
}

/// Unix 秒 → `YYYY-MM-DD`（UTC）
#[alloc]
#[state]
pub fn format_date(int unix) -> String {
    d = DateTime::from_unix(unix);
    res = pad_left(d.year.to_string(), 4usize, '0') + "-";
    res = res + pad_left(d.month.to_string(), 2usize, '0') + "-";
    res = res + pad_left(d.day.to_string(), 2usize, '0');
    return res;
}
