import "string"
import "convert"
import "option"

#[io]
extern "C" fn __ayanami_getchar() -> int;
#[io]
extern "C" fn __ayanami_putchar(int c);
#[io]
extern "C" fn __ayanami_print_str([char] s, int len);
#[io]
extern "C" fn __ayanami_print_ln();

#[io]
pub fn getchar() -> int { 
    return __ayanami_getchar() 
}
#[io]
pub fn putchar(int c) { 
    __ayanami_putchar(c); 
}
#[alloc]
#[io]
pub fn print(ref String n) { 
    __ayanami_print_str(n.data, n.len as int); 
}
#[alloc]
#[io]
pub fn println() {
    __ayanami_print_ln(); 
}
#[alloc]
#[io]
pub fn println(ref String s) {
    print(s)
    println()
}

// ── A6：常用类型的 print/println 重载 ──

#[io]
extern "C" fn __ayanami_print_int(int n);
#[io]
extern "C" fn __ayanami_float_len(float n) -> int;
#[io]
extern "C" fn __ayanami_float_str(float n, int len) -> [char];

#[alloc]
#[io]
pub fn print(int n) {
    __ayanami_print_int(n)
}

#[alloc]
#[io]
pub fn print(float f) {
    n = __ayanami_float_len(f)
    data = __ayanami_float_str(f, n)
    __ayanami_print_str(data, n)
}

#[alloc]
#[io]
pub fn print(bool b) {
    if b {
        print("true")
    } else {
        print("false")
    }
}

#[alloc]
#[io]
pub fn print(char c) {
    buf = [c]
    __ayanami_print_str(buf, 1)
}

#[alloc]
#[io]
pub fn println(int n) {
    print(n)
    println()
}

#[alloc]
#[io]
pub fn println(float f) {
    print(f)
    println()
}

#[alloc]
#[io]
pub fn println(bool b) {
    print(b)
    println()
}

#[alloc]
#[io]
pub fn println(char c) {
    print(c)
    println()
}

// ── 行输入（纯 Ayanami；不依赖 runtime 扩展） ──

/// 读取一行（不含换行；EOF 返回空串）
#[alloc]
#[state]
#[io]
pub fn read_line() -> String {
    s = String::empty()
    c = getchar()
    while c >= 0 && c != 10 {
        if c != 13 {
            ch = c as char
            s = s.add(ch.to_string())
        }
        c = getchar()
    }
    empty = ""
    return s.add(empty)
}

/// 读取一行并宽松解析为 int（失败 0）
#[alloc]
#[state]
#[io]
pub fn read_int() -> int {
    return read_line().trim().parse_int()
}

/// 读取一行并严格解析为 int（失败 None）
#[alloc]
#[state]
#[io]
pub fn try_read_int() -> Option[int] {
    return read_line().trim().try_parse_int()
}

/// 读取一行并宽松解析为 float（失败 0.0）
#[alloc]
#[state]
#[io]
pub fn read_float() -> float {
    return read_line().trim().parse_float()
}

/// 读取一行并严格解析为 float（失败 None）
#[alloc]
#[state]
#[io]
pub fn try_read_float() -> Option[float] {
    return read_line().trim().try_parse_float()
}

/// 读取一行并宽松解析为 bool（失败 false）
#[alloc]
#[state]
#[io]
pub fn read_bool() -> bool {
    return read_line().trim().try_parse_bool().unwrap_or(false)
}

/// 读取一行并严格解析为 bool（失败 None）
#[alloc]
#[state]
#[io]
pub fn try_read_bool() -> Option[bool] {
    return read_line().trim().try_parse_bool()
}
