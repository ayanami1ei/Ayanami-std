import "arraylist";

import "arch_x86_64";

import "sync";

// channel — 多生产者单消费者通道（S4；设计见 docs/dev/concurrency.md）
//
// - mpsc：多个线程 send，一个接收者 recv；
// - 队列：Mutex 保护的双栈（send 入 in_stack；recv 时倒到 out_stack → FIFO，均摊 O(1)）；
// - 唤醒：Channel 内的 seq 原子字——send 后递增并 futex_wake；
//   recv 在空队列时按「先取队列 → 再采样 seq → 等待」顺序避免丢失唤醒：
//   若 send 发生在采样之后，futex 比较失败立即返回；发生在采样之前则 seq 不等而重试。
// - 暂不提供 close（recv 阻塞至有数据）。

pub struct ChanState[T] {
    ArrayList[T] in_stack
    ArrayList[T] out_stack
}

pub struct Channel[T] {
    Mutex[ChanState[T]] state
    int seq          // 数据可用（recv 等待）
    int space_seq    // 空间释放（有界 send 等待）
    int closed
    int cap          // 0 = 无界
    int slots        // 空闲槽位（仅 cap > 0 时使用）
}

pub namespace Channel {
    pub fn new[T]() -> Channel[T] {
        return Channel[T] {
            state = Mutex::new[ChanState[T]](ChanState[T] {
                in_stack = ArrayList::new[T](),
                out_stack = ArrayList::new[T]()
            }),
            seq = 0,
            space_seq = 0,
            closed = 0,
            cap = 0,
            slots = 0
        };
    }

    /// 有界通道（cap 个槽位；满时 send 阻塞 —— 背压）
    pub fn new_bounded[T](int cap) -> Channel[T] {
        c = cap
        if c <= 0 {
            c = 1
        }
        return Channel[T] {
            state = Mutex::new[ChanState[T]](ChanState[T] {
                in_stack = ArrayList::new[T](),
                out_stack = ArrayList::new[T]()
            }),
            seq = 0,
            space_seq = 0,
            closed = 0,
            cap = c,
            slots = c
        };
    }
}

impl[T] Channel[T] {
    /// 发送（多生产者安全；唤醒一个等待的接收者）
    #[io]
    #[state]
    pub fn send(ref self, T v) -> void {
        if self.cap > 0 {
            while true {
                if ArchX86_64::atomic_load(ref self.closed) != 0 {
                    return
                }
                n = ArchX86_64::atomic_fetch_sub(ref self.slots, 1);
                if n > 0 {
                    break
                }
                ArchX86_64::atomic_fetch_add(ref self.slots, 1);
                s0 = ArchX86_64::atomic_load(ref self.space_seq);
                if ArchX86_64::atomic_load(ref self.space_seq) == s0 {
                    unsafe {
                        __ayanami_futex_wait(ref self.space_seq as *int, s0)
                    }
                }
            }
        }
        self.state.with_lock((ref mut ChanState[T] s) -> void { s.in_stack.push(v) });
        ArchX86_64::atomic_fetch_add(ref self.seq, 1);
        unsafe {
            __ayanami_futex_wake(ref self.seq as *int, 1)
        }
    }

    /// 非阻塞接收（无数据 → None）
    #[io]
    #[state]
    pub fn try_recv(ref mut self) -> Option[T] {
        got = self.state.with_lock((ref mut ChanState[T] s) -> Option[T] {
            return pop_front(s)
        });
        if got.is_some() && self.cap > 0 {
            ArchX86_64::atomic_fetch_add(ref self.slots, 1);
            ArchX86_64::atomic_fetch_add(ref self.space_seq, 1);
            unsafe {
                __ayanami_futex_wake(ref self.space_seq as *int, 1)
            }
        }
        return got;
    }

    /// 阻塞接收（关闭且无数据 → panic；需要 Option 用 recv_opt）
    #[io]
    #[state]
    #[alloc]
    pub fn recv(ref mut self) -> T {
        return self.recv_opt().unwrap()
    }

    /// 阻塞接收：返回 Some(值)；通道已关闭且已取空 → None
    #[io]
    #[state]
    #[alloc]
    pub fn recv_opt(ref mut self) -> Option[T] {
        while true {
            seq0 = ArchX86_64::atomic_load(ref self.seq);
            got = self.state.with_lock((ref mut ChanState[T] s) -> Option[T] {
                return pop_front(s)
            });
            if got.is_some() {
                if self.cap > 0 {
                    ArchX86_64::atomic_fetch_add(ref self.slots, 1);
                    ArchX86_64::atomic_fetch_add(ref self.space_seq, 1);
                    unsafe {
                        __ayanami_futex_wake(ref self.space_seq as *int, 1)
                    }
                }
                return got
            }
            if ArchX86_64::atomic_load(ref self.closed) != 0 {
                return Option::None()
            }
            if ArchX86_64::atomic_load(ref self.seq) != seq0 {
                continue
            }
            unsafe {
                __ayanami_futex_wait(ref self.seq as *int, seq0)
            }
        }
    }

    /// 关闭通道：唤醒所有等待接收者；关闭后 send 不再接受新消费者（文档约定）
    #[io]
    #[state]
    pub fn close(ref self) -> void {
        ArchX86_64::atomic_store(ref self.closed, 1);
        ArchX86_64::atomic_fetch_add(ref self.seq, 1);
        ArchX86_64::atomic_fetch_add(ref self.space_seq, 1);
        unsafe {
            __ayanami_futex_wake(ref self.seq as *int, 2147483647);
            __ayanami_futex_wake(ref self.space_seq as *int, 2147483647)
        }
    }
}

/// 队列出队（双栈倒换；调用方持锁）
#[state]
fn pop_front[T](ref mut ChanState[T] s) -> Option[T] {
    if s.out_stack.is_empty() {
        while !s.in_stack.is_empty() {
            s.out_stack.push(s.in_stack.pop())
        }
    }
    if s.out_stack.is_empty() {
        return Option::None()
    }
    return Option::Some(s.out_stack.pop())
}

#[extern]
fn __ayanami_futex_wait(*int addr, int expected) -> int;

#[extern]
fn __ayanami_futex_wake(*int addr, int n) -> int;
