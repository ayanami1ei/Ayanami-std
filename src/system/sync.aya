import "arch_x86_64";

// sync — 并发原语（S1：原子；锁/线程/通道见 docs/dev/concurrency.md）
//
// 设计（M7 038.1）：docs/dev/concurrency.md。
// - 原子操作为顺序一致语义，由 core/arch_x86_64.aya 内联汇编实现（无运行时依赖）；
// - 无 Drop → 锁采用回调式 with_lock（S3）；线程/通道按 S2/S4 落地；
// - 内存序模型：x86-64 TSO，lock 前缀操作 = 全栅栏。
//
// 注意：AtomicInt 操作均需 ref self（可取地址的值），共享时经 ref 传递。

pub struct AtomicInt {
    int value
}

pub namespace AtomicInt {
    /// 新建（初值）
    pub fn new(int v) -> AtomicInt {
        return AtomicInt { value = v };
    }
}

impl AtomicInt {
    /// 原子加载（顺序一致）
    #[state]
    pub fn load(ref self) -> int {
        return ArchX86_64::atomic_load(ref self.value);
    }

    /// 原子存储（顺序一致）
    #[state]
    pub fn store(ref self, int v) {
        ArchX86_64::atomic_store(ref self.value, v);
    }

    /// 原子交换（返回旧值）
    #[state]
    pub fn swap(ref self, int v) -> int {
        return ArchX86_64::atomic_swap(ref self.value, v);
    }

    /// 原子加（返回旧值）
    #[state]
    pub fn fetch_add(ref self, int v) -> int {
        return ArchX86_64::atomic_fetch_add(ref self.value, v);
    }

    /// 原子减（返回旧值）
    #[state]
    pub fn fetch_sub(ref self, int v) -> int {
        return ArchX86_64::atomic_fetch_sub(ref self.value, v);
    }

    /// 原子比较交换（返回旧值；`old == expected` 表示成功）
    #[state]
    pub fn compare_exchange(ref self, int expected, int new) -> int {
        return ArchX86_64::atomic_compare_exchange(ref self.value, expected, new);
    }

    /// 原子按位与（返回旧值；CAS 循环）
    #[state]
    pub fn fetch_and(ref self, int v) -> int {
        while true {
            old = ArchX86_64::atomic_load(ref self.value);
            if ArchX86_64::atomic_compare_exchange(ref self.value, old, old & v) == old {
                return old
            }
        }
    }

    /// 原子按位或（返回旧值；CAS 循环）
    #[state]
    pub fn fetch_or(ref self, int v) -> int {
        while true {
            old = ArchX86_64::atomic_load(ref self.value);
            if ArchX86_64::atomic_compare_exchange(ref self.value, old, old | v) == old {
                return old
            }
        }
    }

    /// 原子按位异或（返回旧值；CAS 循环）
    #[state]
    pub fn fetch_xor(ref self, int v) -> int {
        while true {
            old = ArchX86_64::atomic_load(ref self.value);
            if ArchX86_64::atomic_compare_exchange(ref self.value, old, old ^ v) == old {
                return old
            }
        }
    }
}

/// 全内存栅栏（mfence）
#[state]
pub fn fence() {
    ArchX86_64::fence();
}

/// 自旋提示（pause）
#[state]
pub fn cpu_relax() {
    ArchX86_64::cpu_relax();
}

#[extern]
fn __ayanami_futex_wait(*int addr, int expected) -> int;

#[extern]
fn __ayanami_futex_wake(*int addr, int n) -> int;

/// 互斥锁（futex；无 Drop → 回调式 with_lock，或显式 lock/unlock 配对）
///
/// state：0 空闲 / 1 占用 / 2 占用且有等待者（futex 等待字）。
pub struct Mutex[T] {
    int state
    T payload
}

pub namespace Mutex {
    pub fn new[T](T v) -> Mutex[T] {
        return Mutex[T] { state = 0, payload = v };
    }
}

impl[T] Mutex[T] {
    /// 加锁 → 以 `ref mut` 传入载荷 → 解锁；返回回调结果（void 回调可作语句）
    #[io]
    #[state]
    pub fn with_lock[U](ref mut self, Fn(ref mut T) -> U f) -> U {
        self.lock();
        r = f(ref mut self.payload);
        self.unlock();
        return r;
    }

    /// 尝试加锁并执行回调；已被占用 → None（不阻塞）
    #[io]
    #[state]
    pub fn try_with_lock[U](ref mut self, Fn(ref mut T) -> U f) -> Option[U] {
        if ArchX86_64::atomic_compare_exchange(ref self.state, 0, 1) != 0 {
            return Option::None()
        }
        r = f(ref mut self.payload);
        self.unlock();
        return Option::Some(r)
    }

    /// 显式加锁（必须配对 unlock）
    #[io]
    #[state]
    pub fn lock(ref self) -> void {
        if ArchX86_64::atomic_compare_exchange(ref self.state, 0, 1) == 0 {
            return
        }
        while true {
            if ArchX86_64::atomic_load(ref self.state) == 1 {
                ArchX86_64::atomic_compare_exchange(ref self.state, 1, 2);
            }
            unsafe {
                __ayanami_futex_wait(ref self.state as *int, 2)
            }
            if ArchX86_64::atomic_compare_exchange(ref self.state, 0, 2) == 0 {
                return
            }
        }
    }

    /// 解锁；若有等待者则唤醒一个
    #[io]
    #[state]
    pub fn unlock(ref self) -> void {
        if ArchX86_64::atomic_swap(ref self.state, 0) == 2 {
            unsafe {
                __ayanami_futex_wake(ref self.state as *int, 1)
            }
        }
    }

    /// 载荷（仅在持锁期间使用；文档约定）
    pub fn data(ref mut self) -> ref mut T {
        return ref mut self.payload
    }
}

/// 读写锁（futex；state：0 空闲 / n>0 读者数 / -1 写者持有；无 Drop → 回调式）
///
/// 语义：多读者并发；写者独占。写者饥饿未处理（S3 已知限制）。
pub struct RwLock[T] {
    int state
    int writers
    T payload
}

pub namespace RwLock {
    pub fn new[T](T v) -> RwLock[T] {
        return RwLock[T] { state = 0, writers = 0, payload = v };
    }
}

impl[T] RwLock[T] {
    /// 读锁 → 回调（`ref T`）；返回回调结果
    #[io]
    #[state]
    pub fn with_read[U](ref self, Fn(ref T) -> U f) -> U {
        self.acquire_read();
        r = f(ref self.payload);
        self.release_read();
        return r
    }

    /// 写锁 → 回调（`ref mut T`）；返回回调结果
    #[io]
    #[state]
    pub fn with_write[U](ref mut self, Fn(ref mut T) -> U f) -> U {
        self.acquire_write();
        r = f(ref mut self.payload);
        self.release_write();
        return r
    }

    /// 显式读锁（必须配对 unlock_read）
    #[io]
    #[state]
    pub fn lock_read(ref self) -> void {
        self.acquire_read();
    }

    /// 显式读锁解锁
    #[io]
    #[state]
    pub fn unlock_read(ref self) -> void {
        self.release_read();
    }

    /// 显式写锁（必须配对 unlock_write）
    #[io]
    #[state]
    pub fn lock_write(ref self) -> void {
        self.acquire_write();
    }

    /// 显式写锁解锁
    #[io]
    #[state]
    pub fn unlock_write(ref self) -> void {
        self.release_write();
    }

    /// 尝试读锁并执行回调；有写者 → None（不阻塞）
    #[io]
    #[state]
    pub fn try_with_read[U](ref self, Fn(ref T) -> U f) -> Option[U] {
        s = ArchX86_64::atomic_load(ref self.state);
        if s < 0 || ArchX86_64::atomic_load(ref self.writers) > 0 {
            return Option::None()
        }
        if ArchX86_64::atomic_compare_exchange(ref self.state, s, s + 1) != s {
            return Option::None()
        }
        r = f(ref self.payload);
        self.release_read();
        return Option::Some(r)
    }

    /// 尝试写锁并执行回调；非空闲 → None（不阻塞）
    #[io]
    #[state]
    pub fn try_with_write[U](ref mut self, Fn(ref mut T) -> U f) -> Option[U] {
        if ArchX86_64::atomic_compare_exchange(ref self.state, 0, -1) != 0 {
            return Option::None()
        }
        r = f(ref mut self.payload);
        self.release_write();
        return Option::Some(r)
    }

    #[io]
    #[state]
    fn acquire_read(ref self) -> void {
        while true {
            s = ArchX86_64::atomic_load(ref self.state);
            if s >= 0 && ArchX86_64::atomic_load(ref self.writers) == 0 {
                if ArchX86_64::atomic_compare_exchange(ref self.state, s, s + 1) == s {
                    return
                }
            }
            unsafe {
                __ayanami_futex_wait(ref self.state as *int, s)
            }
        }
    }

    #[io]
    #[state]
    fn release_read(ref self) -> void {
        if ArchX86_64::atomic_fetch_sub(ref self.state, 1) == 1 {
            n = 1
            if ArchX86_64::atomic_load(ref self.writers) > 0 {
                n = 2147483647
            }
            unsafe {
                __ayanami_futex_wake(ref self.state as *int, n)
            }
        }
    }

    #[io]
    #[state]
    fn acquire_write(ref self) -> void {
        ArchX86_64::atomic_fetch_add(ref self.writers, 1);
        while true {
            if ArchX86_64::atomic_compare_exchange(ref self.state, 0, -1) == 0 {
                ArchX86_64::atomic_fetch_sub(ref self.writers, 1);
                return
            }
            s = ArchX86_64::atomic_load(ref self.state);
            unsafe {
                __ayanami_futex_wait(ref self.state as *int, s)
            }
        }
    }

    #[io]
    #[state]
    fn release_write(ref self) -> void {
        ArchX86_64::atomic_store(ref self.state, 0);
        unsafe {
            __ayanami_futex_wake(ref self.state as *int, 2147483647)
        }
    }
}

struct BarrierTicket {
    int generation
    int last
}

/// 屏障：N 个线程相互等待，全部到达后一起继续（可重复使用）
///
/// seq：futex 字（每轮 +1）；state 保护到达计数与代数（代数防止丢失唤醒/跨轮误入）。
struct BarrierState {
    int total
    int arrived
    int generation
}

pub struct Barrier {
    int seq
    Mutex[BarrierState] state
}

pub namespace Barrier {
    /// 新建（participants 个线程会合）
    pub fn new(int participants) -> Barrier {
        return Barrier {
            seq = 0,
            state = Mutex::new[BarrierState](BarrierState {
                total = participants,
                arrived = 0,
                generation = 0
            })
        };
    }
}

impl Barrier {
    /// 等待所有参与者到达（阻塞至本轮完成）
    #[io]
    #[state]
    pub fn wait(ref self) -> void {
        // 闭包按值捕获，结果经返回值带出（票据：本轮代数 + 是否最后到达）
        t = self.state.with_lock((ref mut BarrierState s) -> BarrierTicket {
            g = s.generation;
            done = 0;
            s.arrived = s.arrived + 1;
            if s.arrived == s.total {
                s.arrived = 0;
                s.generation = s.generation + 1;
                done = 1;
            }
            return BarrierTicket { generation = g, last = done }
        });
        if t.last == 1 {
            ArchX86_64::atomic_fetch_add(ref self.seq, 1);
            unsafe {
                __ayanami_futex_wake(ref self.seq as *int, 2147483647)
            }
            return
        }
        while true {
            cur = ArchX86_64::atomic_load(ref self.seq);
            if cur > t.generation {
                return
            }
            unsafe {
                __ayanami_futex_wait(ref self.seq as *int, cur)
            }
        }
    }
}

/// 一次性执行：`call_once` 至多执行一次；并发调用者等待完成
///
/// state：0 未开始 / 1 执行中 / 2 完成（futex 等待字）。
pub struct Once {
    int state
}

pub namespace Once {
    pub fn new() -> Once {
        return Once { state = 0 }
    }
}

impl Once {
    #[io]
    #[state]
    pub fn call_once(ref self, Fn() -> void f) -> void {
        if ArchX86_64::atomic_compare_exchange(ref self.state, 0, 1) == 0 {
            f();
            ArchX86_64::atomic_store(ref self.state, 2);
            unsafe {
                __ayanami_futex_wake(ref self.state as *int, 2147483647)
            }
            return
        }
        while ArchX86_64::atomic_load(ref self.state) != 2 {
            unsafe {
                __ayanami_futex_wait(ref self.state as *int, 1)
            }
        }
    }
}

/// 条件变量：与 Mutex 配合的「释放锁 → 等待 → 重取锁」
///
/// seq：futex 字（每次 notify +1）。
/// 契约：`wait` 必须在持锁时调用（内部会释放并重取）；通知方应在**持锁**时修改条件并 notify，
/// 调用方用 `while !predicate { cv.wait(pm) }` 循环重查。
pub struct Condvar {
    int seq
}

pub namespace Condvar {
    pub fn new() -> Condvar {
        return Condvar { seq = 0 }
    }
}

impl Condvar {
    /// 释放互斥锁 → 等待通知 → 重新加锁（须持锁调用）
    #[io]
    #[state]
    pub fn wait[T](ref self, *Mutex[T] m) -> void {
        s = ArchX86_64::atomic_load(ref self.seq);
        unsafe {
            (*m).unlock();
            __ayanami_futex_wait(ref self.seq as *int, s);
            (*m).lock()
        }
    }

    /// 唤醒一个等待者
    #[io]
    #[state]
    pub fn notify_one(ref self) -> void {
        ArchX86_64::atomic_fetch_add(ref self.seq, 1);
        unsafe {
            __ayanami_futex_wake(ref self.seq as *int, 1)
        }
    }

    /// 唤醒全部等待者
    #[io]
    #[state]
    pub fn notify_all(ref self) -> void {
        ArchX86_64::atomic_fetch_add(ref self.seq, 1);
        unsafe {
            __ayanami_futex_wake(ref self.seq as *int, 2147483647)
        }
    }
}
