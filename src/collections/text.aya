// text — 文本处理（split / join / replace / pad）
//
// 依赖 string + arraylist；内部过程式实现，对外声明式一行调用。
import "string"
import "arraylist"
import "option"

/// split_once 的结果：`found` 为是否找到分隔符
pub struct Split {
    bool found
    String before
    String after
}

/// 惰性按行迭代器（消费原串）
pub struct LinesIter {
    String s
    usize i
}

impl LinesIter {
    #[alloc]
    #[state]
    pub fn next(ref mut self) -> Option[String] {
        if self.i >= self.s.len {
            return Option::None()
        }
        start = self.i
        j = self.i
        while j < self.s.len {
            if self.s.data[j] == '\n' {
                end = j
                if end > start {
                    if self.s.data[end - 1] == '\r' {
                        end = end - 1
                    }
                }
                self.i = j + 1
                return Option::Some(self.s.substring(start, end))
            }
            j = j + 1
        }
        self.i = self.s.len
        return Option::Some(self.s.substring(start, self.s.len))
    }
}

impl String {
    /// 惰性按行迭代（消费 self；`\r\n` 兼容、末尾换行不产生空行）
    pub fn lines_iter(self) -> LinesIter {
        return LinesIter { s = self, i = 0 }
    }
}

/// 惰性按空白拆分迭代器（消费原串）
pub struct SplitWhitespaceIter {
    String s
    usize i
}

impl SplitWhitespaceIter {
    #[alloc]
    #[state]
    pub fn next(ref mut self) -> Option[String] {
        while self.i < self.s.len {
            if !self.s.data[self.i].is_space() {
                break
            }
            self.i = self.i + 1
        }
        if self.i >= self.s.len {
            return Option::None()
        }
        start = self.i
        while self.i < self.s.len {
            if self.s.data[self.i].is_space() {
                break
            }
            self.i = self.i + 1
        }
        return Option::Some(self.s.substring(start, self.i))
    }
}

impl String {
    /// 惰性按空白拆分（消费 self；连续空白视为一个分隔，忽略首尾）
    pub fn split_whitespace_iter(self) -> SplitWhitespaceIter {
        return SplitWhitespaceIter { s = self, i = 0 }
    }
}

/// 惰性按分隔符拆分迭代器（消费原串）
pub struct SplitIter {
    String s
    String sep
    usize i
    bool done
}

impl SplitIter {
    #[alloc]
    #[state]
    pub fn next(ref mut self) -> Option[String] {
        if self.done {
            return Option::None()
        }
        if self.sep.len == 0 {
            self.done = true
            return Option::Some(self.s.substring(0, self.s.len))
        }
        start = self.i
        while self.i + self.sep.len <= self.s.len {
            matched = true
            j = 0usize
            while j < self.sep.len {
                if self.s.data[self.i + j] != self.sep.data[j] {
                    matched = false
                    break
                }
                j = j + 1
            }
            if matched {
                end = self.i
                self.i = self.i + self.sep.len
                return Option::Some(self.s.substring(start, end))
            }
            self.i = self.i + 1
        }
        self.done = true
        return Option::Some(self.s.substring(start, self.s.len))
    }
}

impl String {
    /// 惰性按分隔符拆分（消费 self；`sep` 为空时产出整串一次）
    pub fn split_iter(self, String sep) -> SplitIter {
        return SplitIter { s = self, sep = sep, i = 0, done = false }
    }
}


/// 按分隔符切分（`sep` 为空时返回只含原串的列表）
///
/// 基于惰性迭代器 `s.split_iter(sep)` 收集。
#[alloc]
#[state]
pub fn split(ref String s, ref String sep) -> ArrayList[String] {
    res = ArrayList::new[String]()
    for part in s.copy().split_iter(sep.copy()) {
        res.push(part)
    }
    return res
}

/// 用分隔符连接列表元素（空列表 → 空串）
#[alloc]
#[state]
pub fn join(ref ArrayList[String] list, ref String sep) -> String {
    if list.len() == 0 {
        return String::empty()
    }
    res = list.index(0).copy()
    i = 1usize
    while i < list.len() {
        res = res.add(sep)
        res = res.add(list.index(i).copy())
        i = i + 1
    }
    return res
}

/// 替换所有 `old` 为 `new`（`old` 为空时返回原串拷贝）
#[alloc]
#[state]
pub fn replace(ref String s, ref String old, ref String new) -> String {
    if old.len == 0 {
        return s.copy()
    }
    res = String::empty()
    i = 0usize
    while i < s.len {
        if i + old.len <= s.len {
            matched = true
            j = 0usize
            while j < old.len {
                if s.index(i + j) != old.index(j) {
                    matched = false
                    break
                }
                j = j + 1
            }
            if matched {
                res = res.add(new)
                i = i + old.len
            } else {
                res = res.add(s.substring(i, i + 1))
                i = i + 1
            }
        } else {
            res = res.add(s.substring(i, i + 1))
            i = i + 1
        }
    }
    return res
}

/// 左侧填充到 `width`（已足够宽则返回拷贝）
#[alloc]
#[state]
pub fn pad_left(ref String s, usize width, char fill) -> String {
    if s.len >= width {
        return s.copy()
    }
    res = String::empty()
    pad = width - s.len
    k = 0usize
    while k < pad {
        res = res.add(fill.to_string())
        k = k + 1
    }
    res = res.add(s)
    return res
}

/// 右侧填充到 `width`
#[alloc]
#[state]
pub fn pad_right(ref String s, usize width, char fill) -> String {
    if s.len >= width {
        return s.copy()
    }
    res = s.copy()
    pad = width - s.len
    k = 0usize
    while k < pad {
        res = res.add(fill.to_string())
        k = k + 1
    }
    return res
}

/// 按行拆分（`\n`，兼容 `\r\n`；末尾换行不产生空行）
///
/// 基于惰性迭代器 `s.lines_iter()` 收集。
#[alloc]
#[state]
pub fn lines(ref String s) -> ArrayList[String] {
    res = ArrayList::new[String]()
    for ln in s.copy().lines_iter() {
        res.push(ln)
    }
    return res
}

/// 在首个 `sep` 处切分为两段；未找到时 `found=false`、`before` 为原串拷贝、`after` 为空串
#[alloc]
#[state]
pub fn split_once(ref String s, ref String sep) -> Split {
    pos = s.index_of(sep)
    if pos < 0 {
        return Split { found = false, before = s.copy(), after = "" }
    }
    p = pos as usize
    before = s.substring(0, p)
    after = s.substring(p + sep.len, s.len)
    return Split { found = true, before = before, after = after }
}

/// 按空白字符拆分（连续空白视为一个分隔；忽略首尾空白）
///
/// 基于惰性迭代器 `s.split_whitespace_iter()` 收集。
#[alloc]
#[state]
pub fn split_whitespace(ref String s) -> ArrayList[String] {
    res = ArrayList::new[String]()
    for w in s.copy().split_whitespace_iter() {
        res.push(w)
    }
    return res
}

/// needle 的非重叠出现次数（needle 为空返回 0）
#[pure]
pub fn count(ref String s, ref String needle) -> int {
    if needle.is_empty() {
        return 0
    }
    n = 0
    i = 0usize
    while i + needle.len <= s.len {
        j = 0usize
        hit = true
        while j < needle.len {
            if s.data[i + j] != needle.data[j] {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            n = n + 1
            i = i + needle.len
        } else {
            i = i + 1
        }
    }
    return n
}
