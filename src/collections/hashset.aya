// hashset — 泛型哈希集合（开放寻址 + 线性探测）
//
// state：0=空、1=占用、2=墓碑；filled 为占用+墓碑槽数，
// 装填因子超过 0.5 时扩容（grow 顺带清墓碑），保证探测必然终止。
import "hash";

import "arraylist";

import "iter";

import "sort";

pub struct HashSet[K: Hash] {
    [K] keys
    [int] state
    usize len
    usize filled
    usize cap
}

pub namespace HashSet {
    pub fn new[K: Hash]() -> HashSet[K] {
        return HashSet[K] { keys = null, state = null, len = 0, filled = 0, cap = 0 };
    }
    /// 预分配槽位数（cap <= 0 等价 new）
    #[alloc]
    pub fn with_capacity[K: Hash](usize cap) -> HashSet[K] {
        if cap == 0 {
            return HashSet[K] { keys = null, state = null, len = 0, filled = 0, cap = 0 };
        }
        return HashSet[K] { keys = [K; cap], state = [int; cap], len = 0, filled = 0, cap = cap };
    }
}

impl[K: Hash] HashSet[K] {
    #[alloc]
    #[state]
    fn grow(ref mut self) {
        new_cap = 8usize;
        if self.cap > 0 {
            new_cap = self.cap * 2;
        }
        nk = [K; new_cap];
        ns = [int; new_cap];
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                k = self.keys[i];
                nc = new_cap as int;
                h = k.hash() % nc;
                j = h as usize;
                while ns[j] != 0 {
                    j = (j + 1) % new_cap;
                }
                nk[j] = k;
                ns[j] = 1;
            }
            i = i + 1;
        }
        self.keys = nk;
        self.state = ns;
        self.cap = new_cap;
        self.filled = self.len;
    }
    /// 插入；已存在返回 false
    #[alloc]
    #[state]
    fn insert(ref mut self, K k) -> bool {
        if self.cap == 0 {
            self.grow()
        }
        if (self.filled + 1) * 2 >= self.cap {
            self.grow()
        }
        i = (k.hash() % self.cap as int) as usize;
        while true {
            if self.state[i] == 0 {
                self.keys[i] = k;
                self.state[i] = 1;
                self.len = self.len + 1;
                self.filled = self.filled + 1;
                return true;
            }
            if self.state[i] == 1 {
                if self.keys[i].hash_eq(ref k) {
                    return false;
                }
            }
            i = (i + 1) % self.cap;
        }
        return false;
    }
    /// 是否包含
    fn contains(ref self, ref K k) -> bool {
        if self.cap == 0 {
            return false;
        }
        i = (k.hash() % self.cap as int) as usize;
        while true {
            s = self.state[i];
            if s == 0 {
                return false;
            }
            if s == 1 {
                if self.keys[i].hash_eq(k) {
                    return true;
                }
            }
            i = (i + 1) % self.cap;
        }
        return false;
    }
    /// 删除并返回元素；不存在返回 None
    #[state]
    fn take(ref mut self, ref K k) -> Option[K] {
        if self.cap == 0 {
            return Option::None();
        }
        i = (k.hash() % self.cap as int) as usize;
        while true {
            s = self.state[i];
            if s == 0 {
                return Option::None();
            }
            if s == 1 {
                if self.keys[i].hash_eq(k) {
                    e = self.keys[i];
                    self.state[i] = 2;
                    self.len = self.len - 1;
                    return Option::Some(e);
                }
            }
            i = (i + 1) % self.cap;
        }
        return Option::None();
    }
    /// 删除（墓碑）；不存在返回 false
    #[state]
    fn remove(ref mut self, ref K k) -> bool {
        if self.cap == 0 {
            return false;
        }
        i = (k.hash() % self.cap as int) as usize;
        while true {
            s = self.state[i];
            if s == 0 {
                return false;
            }
            if s == 1 {
                if self.keys[i].hash_eq(k) {
                    self.state[i] = 2;
                    self.len = self.len - 1;
                    return true;
                }
            }
            i = (i + 1) % self.cap;
        }
        return false;
    }
    /// 原地保留满足谓词的元素
    #[state]
    fn retain(ref mut self, Fn(K)->bool f) {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if !f(self.keys[i]) {
                    self.state[i] = 2;
                    self.len = self.len - 1;
                }
            }
            i = i + 1;
        }
    }
    /// 清空（保留容量）
    #[state]
    fn clear(ref mut self) {
        i = 0usize;
        while i < self.cap {
            self.state[i] = 0;
            i = i + 1;
        }
        self.len = 0;
        self.filled = 0;
    }
    /// 是否子集（所有元素都在 other 中；空集为任何集合的子集）
    fn is_subset_of(ref self, ref HashSet[K] other) -> bool {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                k = self.keys[i];
                if !other.contains(k) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }
    /// 是否超集（包含 other 的所有元素）
    fn is_superset_of(ref self, ref HashSet[K] other) -> bool {
        return other.is_subset_of(self);
    }
    /// 原地删除 other 中的元素（差集）
    #[state]
    fn remove_all(ref mut self, ref HashSet[K] other) {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                k = self.keys[i];
                if other.contains(k) {
                    self.state[i] = 2;
                    self.len = self.len - 1;
                }
            }
            i = i + 1;
        }
    }
    /// 原地仅保留 other 中的元素（交集）
    #[state]
    fn retain_all(ref mut self, ref HashSet[K] other) {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                k = self.keys[i];
                if !other.contains(k) {
                    self.state[i] = 2;
                    self.len = self.len - 1;
                }
            }
            i = i + 1;
        }
    }
    /// 并集（新集合）
    ///
    /// 注：`union` 为语言关键字，成员位置允许（#172）故可直接用该名。
    #[alloc]
    #[state]
    fn union(ref self, ref HashSet[K] other) -> HashSet[K] {
        res = HashSet::new[K]();
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                res.insert(self.keys[i])
            }
            i = i + 1;
        }
        i = 0usize;
        while i < other.cap {
            if other.state[i] == 1 {
                res.insert(other.keys[i])
            }
            i = i + 1;
        }
        return res;
    }
    /// 交集（新集合）
    #[alloc]
    #[state]
    fn intersection(ref self, ref HashSet[K] other) -> HashSet[K] {
        res = HashSet::new[K]();
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if other.contains(self.keys[i]) {
                    res.insert(self.keys[i])
                }
            }
            i = i + 1;
        }
        return res;
    }
    /// 差集 self - other（新集合）
    #[alloc]
    #[state]
    fn difference(ref self, ref HashSet[K] other) -> HashSet[K] {
        res = HashSet::new[K]();
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if !other.contains(self.keys[i]) {
                    res.insert(self.keys[i])
                }
            }
            i = i + 1;
        }
        return res;
    }
    /// 遍历所有元素（浅拷贝；顺序为实现相关）
    fn for_each(ref self, Fn(K) f) {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                f(self.keys[i])
            }
            i = i + 1;
        }
    }
    /// 折叠：acc = f(acc, k)
    fn fold[U](ref self, U init, Fn(U,K)->U f) -> U {
        acc = init;
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                acc = f(acc, self.keys[i]);
            }
            i = i + 1;
        }
        return acc;
    }
    /// 所有元素（浅拷贝；顺序为实现相关）
    #[alloc]
    #[state]
    fn to_list(ref self) -> ArrayList[K] {
        res = ArrayList::new[K]();
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                res.push(self.keys[i])
            }
            i = i + 1;
        }
        return res;
    }
    fn len(ref self) -> usize {
        return self.len;
    }
    fn is_empty(ref self) -> bool {
        return self.len == 0;
    }
}

/// 需要元素实现 ToString（形如 `{a, b}`，顺序为实现相关）
impl[K: Hash + ToString] HashSet[K] {
    #[alloc]
    #[state]
    fn to_string(ref self) -> String {
        res = "{";
        first = true;
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if !first {
                    res = res + ", ";
                }
                res = res + self.keys[i];
                first = false;
            }
            i = i + 1;
        }
        res = res + "}";
        return res;
    }
}

/// 拥有型迭代器（顺序为实现相关）
pub struct HashSetIter[K: Hash] {
    HashSet[K] set
    usize index
}

impl[K: Hash] HashSetIter[K] {
    #[state]
    fn next(ref mut self) -> Option[K] {
        while self.index < self.set.cap {
            if self.set.state[self.index] == 1 {
                k = self.set.keys[self.index];
                self.index = self.index + 1;
                return Option::Some(k);
            }
            self.index = self.index + 1;
        }
        return Option::None();
    }
}

impl[K: Hash] HashSet[K] {
    /// 转为拥有所有权的迭代器（`for k in s.into_iter()`）
    fn into_iter(self) -> HashSetIter[K] {
        return HashSetIter[K] { set = self, index = 0 };
    }
}

/// 谓词族（与 ArrayList/HashMap 对齐）
impl[K: Hash] HashSet[K] {
    /// 是否存在满足谓词的元素
    fn any(ref self, Fn(K)->bool f) -> bool {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if f(self.keys[i]) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }
    /// 是否所有元素满足谓词（空集 true）
    fn all(ref self, Fn(K)->bool f) -> bool {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if !f(self.keys[i]) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }
    /// 满足谓词的元素个数
    fn count(ref self, Fn(K)->bool f) -> usize {
        n = 0usize;
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if f(self.keys[i]) {
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        return n;
    }
    /// 首个满足谓词的元素；无则 None
    fn find(ref self, Fn(K)->bool f) -> Option[K] {
        i = 0usize;
        while i < self.cap {
            if self.state[i] == 1 {
                if f(self.keys[i]) {
                    return Option::Some(self.keys[i]);
                }
            }
            i = i + 1;
        }
        return Option::None();
    }
}

/// 需要元素实现 Ord（排序视图）
impl[K: Hash + Ord] HashSet[K] {
    /// 排序后的元素列表（升序）
    #[alloc]
    #[state]
    fn sorted_list(ref self) -> ArrayList[K] {
        ls = self.to_list();
        ls.sort();
        return ls;
    }
}
