import "string"
import "panic"
import "list"
import "eq"
import "option"

pub struct ArrayList[T]{
    [T] data
    usize len
    usize capability
}

pub namespace ArrayList {
    /// 空表
    pub fn new[T]() -> ArrayList[T] {
        return ArrayList[T] { data = null, len = 0, capability = 0 }
    }
    /// 预分配容量（cap <= 0 时等价于 new）
#[alloc]
    pub fn with_capacity[T](usize cap) -> ArrayList[T] {
        if cap == 0 {
            return ArrayList[T] { data = null, len = 0, capability = 0 }
        }
        return ArrayList[T] { data = [T; cap], len = 0, capability = cap }
    }
}

impl[T] ArrayList[T]{
#[alloc]
#[state]
    fn expand(ref mut self){
        if self.capability == 0 {
            self.capability = 1
            self.data = [T; 1]
        } else {
            tmp = [T; self.capability * 2]
            for i in (0, self.len as int) { tmp[i] = self.data[i] }
            self.data = tmp
            self.capability = self.capability * 2
        }
    }

#[alloc]
#[state]
    pub fn push(ref mut self, T val){
        if self.len + 1 >= self.capability { self.expand() }
        self.data[self.len] = val
        self.len = self.len + 1
    }

    pub fn index(ref self, usize index, int __line, int __col, String __file)->T{
        if index >= self.len { panic_bounds_at(__line, __col, __file, index, self.len) }
        return self.data[index]
    }
    pub fn len(ref self)->usize{ return self.len }

#[state]
    pub fn set(ref mut self, usize i, T v, int __line, int __col, String __file) {
        if i >= self.len { panic_bounds_at(__line, __col, __file, i, self.len) }
        self.data[i] = v
    }

    /// 弹出末元素（调用方需自行保证非空）
#[alloc]
#[state]
    pub fn pop(ref mut self, int __line, int __col, String __file) -> T {
        if self.len == 0 { panic_at(__line, __col, __file, "pop from empty ArrayList") }
        self.len = self.len - 1
        return self.data[self.len]
    }

    pub fn is_empty(ref self) -> bool {
        return self.len == 0
    }

    /// 清空（保留底层缓冲，元素不做逐个释放）
#[state]
    pub fn clear(ref mut self) {
        self.len = 0
    }

    pub fn iter(ref self, Fn(T) f) {
        for i in (0, self.len as int) {
            f(self.data[i])
        }
    }
}

/// 需要元素实现 ToString
impl[T:ToString] ArrayList[T] {
#[alloc]
#[state]
    pub fn to_string(ref self)->String{
        res = "["
        for i in (0, self.len as int){
            res = res + self.data[i]
            if i != self.len as int - 1 { res = res + ", " }
        }
        res = res + "]"
        return res
    }
}

/// 需要元素实现 Eq
impl[T: Eq] ArrayList[T] {
    /// 是否包含（线性查找）
    pub fn contains(ref self, ref T v) -> bool {
        i = 0usize
        while i < self.len {
            if self.data[i].same(v) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 首次出现下标；未找到返回 -1
    pub fn index_of(ref self, ref T v) -> int {
        i = 0usize
        while i < self.len {
            if self.data[i].same(v) {
                return i as int
            }
            i = i + 1
        }
        return 0 - 1
    }

    /// 删除首个等于 v 的元素（后续前移）；未找到返回 false
    #[state]
    pub fn remove(ref mut self, ref T v) -> bool {
        i = 0usize
        while i < self.len {
            if self.data[i].same(v) {
                j = i
                while j + 1 < self.len {
                    self.data[j] = self.data[j + 1]
                    j = j + 1
                }
                self.len = self.len - 1
                return true
            }
            i = i + 1
        }
        return false
    }
}

impl[T] ArrayList[T] {
    /// 映射为新表
    #[alloc]
    #[state]
    pub fn map[U](ref self, Fn(T) -> U f) -> ArrayList[U] {
        res = ArrayList::new[U]()
        i = 0usize
        while i < self.len {
            res.push(f(self.data[i]))
            i = i + 1
        }
        return res
    }

    /// 过滤为新表
    #[alloc]
    #[state]
    pub fn filter(ref self, Fn(T) -> bool f) -> ArrayList[T] {
        res = ArrayList::new[T]()
        i = 0usize
        while i < self.len {
            if f(self.data[i]) {
                res.push(self.data[i])
            }
            i = i + 1
        }
        return res
    }

    /// 折叠：acc = f(acc, item)
    pub fn fold[U](ref self, U init, Fn(U, T) -> U f) -> U {
        acc = init
        i = 0usize
        while i < self.len {
            acc = f(acc, self.data[i])
            i = i + 1
        }
        return acc
    }

    /// 是否存在满足谓词的元素
    pub fn any(ref self, Fn(T) -> bool f) -> bool {
        i = 0usize
        while i < self.len {
            if f(self.data[i]) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 是否所有元素满足谓词
    pub fn all(ref self, Fn(T) -> bool f) -> bool {
        i = 0usize
        while i < self.len {
            if !f(self.data[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 首个满足谓词的元素；无则 None
    pub fn find(ref self, Fn(T) -> bool f) -> Option[T] {
        i = 0usize
        while i < self.len {
            if f(self.data[i]) {
                return Option::Some(self.data[i])
            }
            i = i + 1
        }
        return Option::None()
    }

    /// 原地反转
    #[state]
    pub fn reverse(ref mut self) {
        i = 0usize
        j = self.len
        while i + 1 < j {
            j = j - 1
            tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
            i = i + 1
        }
    }

    /// 在 idx 处插入（idx == len 等价 push）；越界 panic 101
    #[alloc]
    #[state]
    pub fn insert_at(ref mut self, usize idx, T v, int __line, int __col, String __file) {
        if idx > self.len {
            panic_bounds_at(__line, __col, __file, idx, self.len)
        }
        if self.len + 1 >= self.capability {
            self.expand()
        }
        j = self.len
        while j > idx {
            self.data[j] = self.data[j - 1]
            j = j - 1
        }
        self.data[idx] = v
        self.len = self.len + 1
    }

    /// 删除 idx 处元素（后续前移）；越界 panic 101
    #[state]
    pub fn remove_at(ref mut self, usize idx, int __line, int __col, String __file) {
        if idx >= self.len {
            panic_bounds_at(__line, __col, __file, idx, self.len)
        }
        j = idx
        while j + 1 < self.len {
            self.data[j] = self.data[j + 1]
            j = j + 1
        }
        self.len = self.len - 1
    }

    /// 首元素（空表 panic 101）
    pub fn first(ref self, int __line, int __col, String __file) -> T {
        if self.len == 0 {
            panic_at(__line, __col, __file, "first from empty ArrayList")
        }
        return self.data[0]
    }

    /// 末元素（空表 panic 101）
    pub fn last(ref self, int __line, int __col, String __file) -> T {
        if self.len == 0 {
            panic_at(__line, __col, __file, "last from empty ArrayList")
        }
        return self.data[self.len - 1]
    }
}
