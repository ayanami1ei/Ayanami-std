// json — JSON 字符串转义与后续值模型的基础
//
// `char` 即字节：非 ASCII 内容按 UTF-8 原样输出（不强制 `\u` 转义）。
import "string";

import "option";

import "arraylist";

import "iter";

fn hex_val(int c) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

fn hex_digit(int v) -> char {
    if v < 10 {
        return (48 + v) as char
    }
    return (87 + v) as char
}

/// 转义 JSON 字符串内容（不含外层引号）
#[alloc]
#[state]
pub fn escape(ref String s) -> String {
    res = "";
    i = 0usize;
    while i < s.len {
        c = s.data[i];
        b = c as int;
        if c == '"' {
            res = res + "\\\""
        } else {
            if c == '\\' {
                res = res + "\\\\"
            } else {
                if b == 8 {
                    res = res + "\\b"
                } else {
                    if b == 12 {
                        res = res + "\\f"
                    } else {
                        if b == 10 {
                            res = res + "\\n"
                        } else {
                            if b == 13 {
                                res = res + "\\r"
                            } else {
                                if b == 9 {
                                    res = res + "\\t"
                                } else {
                                    if b < 32 {
                                        res = res + "\\u00";
                                        res = res + hex_digit(b >> 4).to_string();
                                        res = res + hex_digit(b & 0xf).to_string()
                                    } else {
                                        res = res + c.to_string()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return res
}

/// 加外层引号的 JSON 字符串
#[alloc]
#[state]
pub fn quote(ref String s) -> String {
    return "\"" + escape(ref s) + "\""
}

fn push_utf8(String res, int cp) -> String {
    if cp < 0x80 {
        return res + (cp as char).to_string()
    }
    if cp < 0x800 {
        r = res + ((0xc0 | (cp >> 6)) as char).to_string();
        return r + ((0x80 | (cp & 0x3f)) as char).to_string()
    }
    if cp < 0x10000 {
        r = res + ((0xe0 | (cp >> 12)) as char).to_string();
        r = r + ((0x80 | ((cp >> 6) & 0x3f)) as char).to_string();
        return r + ((0x80 | (cp & 0x3f)) as char).to_string()
    }
    r = res + ((0xf0 | (cp >> 18)) as char).to_string();
    r = r + ((0x80 | ((cp >> 12) & 0x3f)) as char).to_string();
    r = r + ((0x80 | ((cp >> 6) & 0x3f)) as char).to_string();
    return r + ((0x80 | (cp & 0x3f)) as char).to_string()
}

fn parse_u4(ref String s, usize at) -> int {
    if at + 4 > s.len {
        return -1
    }
    v = 0;
    j = 0usize;
    while j < 4 {
        d = hex_val(s.data[at + j] as int);
        if d < 0 {
            return -1
        }
        v = (v << 4) | d;
        j = j + 1
    }
    return v
}

/// 反转义 JSON 字符串内容（不含外层引号；非法序列 → None）
#[alloc]
#[state]
pub fn unescape(ref String s) -> Option[String] {
    res = "";
    i = 0usize;
    while i < s.len {
        c = s.data[i];
        if c != '\\' {
            res = res + c.to_string();
            i = i + 1
        } else {
            if i + 1 >= s.len {
                return Option::None()
            }
            e = s.data[i + 1];
            if e == '"' {
                res = res + "\""
            } else {
                if e == '\\' {
                    res = res + "\\"
                } else {
                    if e == '/' {
                        res = res + "/"
                    } else {
                        if e == 'b' {
                            res = res + (8 as char).to_string()
                        } else {
                            if e == 'f' {
                                res = res + (12 as char).to_string()
                            } else {
                                if e == 'n' {
                                    res = res + "\n"
                                } else {
                                    if e == 'r' {
                                        res = res + "\r"
                                    } else {
                                        if e == 't' {
                                            res = res + "\t"
                                        } else {
                                            if e == 'u' {
                                                cp = parse_u4(ref s, i + 2);
                                                if cp < 0 {
                                                    return Option::None()
                                                }
                                                if cp >= 0xd800 && cp <= 0xdbff {
                                                    if i + 11 >= s.len || s.data[i + 6] != '\\' || s.data[i + 7] != 'u' {
                                                        return Option::None()
                                                    }
                                                    lo = parse_u4(ref s, i + 8);
                                                    if lo < 0xdc00 || lo > 0xdfff {
                                                        return Option::None()
                                                    }
                                                    cp = 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00);
                                                    i = i + 12
                                                } else {
                                                    if cp >= 0xdc00 && cp <= 0xdfff {
                                                        return Option::None()
                                                    }
                                                    i = i + 6
                                                }
                                                res = push_utf8(res, cp)
                                            } else {
                                                return Option::None()
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if e != 'u' {
                i = i + 2
            }
        }
    }
    return Option::Some(res)
}

/// JSON 值（数字区分 `int` / `float`）
pub enum Json {
    Null,
    Bool(bool),
    Int(int),
    Float(float),
    Str(String),
    Array(ArrayList[Json]),
    Object(ArrayList[JsonField]),
}

/// 对象成员（保持插入顺序）
pub struct JsonField {
    String key
    Json value
}

pub namespace JsonField {
    pub fn new(String key, Json value) -> JsonField {
        return JsonField { key = key, value = value }
    }
}

impl Json {
    /// 序列化为 JSON 文本（按引用遍历，不消费自身）
    #[alloc]
    #[state]
    fn render(ref self) -> String {
        return render_ref(ref self)
    }
}

fn render_float(float f) -> String {
    // NaN / Inf 不是合法 JSON，输出 null
    if f != f {
        return "null"
    }
    if f - f != 0.0 {
        return "null"
    }
    return f.to_string()
}

// 按 tag 分发（避免 `match self` 移出载荷后重复析构）。
#[alloc]
#[state]
fn render_ref(ref Json v) -> String {
    tag = v._tag;
    if tag == 0 {
        return "null"
    }
    if tag == 1 {
        return v._data_Bool._0.to_string()
    }
    if tag == 2 {
        return v._data_Int._0.to_string()
    }
    if tag == 3 {
        return render_float(v._data_Float._0)
    }
    if tag == 4 {
        return quote(ref v._data_Str._0)
    }
    if tag == 5 {
        return render_array(ref v._data_Array._0)
    }
    return render_object(ref v._data_Object._0)
}

#[alloc]
#[state]
fn render_array(ref ArrayList[Json] items) -> String {
    res = "[";
    i = 0usize;
    while i < items.len() {
        if i > 0 {
            res = res + ","
        }
        res = res + render_ref(items.index_ref(i));
        i = i + 1
    }
    return res + "]"
}

#[alloc]
#[state]
fn render_object(ref ArrayList[JsonField] fields) -> String {
    res = "{";
    i = 0usize;
    while i < fields.len() {
        if i > 0 {
            res = res + ","
        }
        f = fields.index_ref(i);
        res = res + quote(ref f.key) + ":";
        res = res + render_ref(ref f.value);
        i = i + 1
    }
    return res + "}"
}
