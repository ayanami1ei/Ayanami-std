/// `#assert_contains(s, sub)`：`!s.contains(sub)` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_contains(String input, String s, String sub, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    st = TokenStream::from_bytes(s);
    subt = TokenStream::from_bytes(sub);
    src_s = TokenStream::to_source(st);
    src_sub = TokenStream::to_source(subt);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, st);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ".");
    TokenStream::push_ident(ts, "contains");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, subt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_contains failed: " + escape(src_s) + " contains " + escape(src_sub) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert_some(opt)`：`!opt.is_some()` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_some(String input, String opt, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    ot = TokenStream::from_bytes(opt);
    src_opt = TokenStream::to_source(ot);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, ot);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ".");
    TokenStream::push_ident(ts, "is_some");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_some failed: " + escape(src_opt) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

