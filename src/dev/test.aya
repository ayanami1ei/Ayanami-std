// 标准库测试框架：`#[test]` / `#[should_panic]` 标注 + assert 系列宏
//
// 用法（配合仓库 scripts/test.sh）：
//   import "test"
//
//   #[test]
//   fn test_add() -> int {
//       #assert_eq(1 + 1, 2)
//       #assert_lt(1, 2)
//       return 0
//   }
//
// 约定：
// - 一个用例函数只写一个标注：`#[test]`（应通过）或 `#[should_panic]`（应 panic，退出码 101）。
// - 用例函数写成 `-> int` 并在末尾 `return 0`：规避“块尾表达式语句丢失”编译器缺陷
//   （ayanami1ei/Ayanami-language#85），修复后可简化为 void。
// - 语句块级 `#[should_panic] { ... }` 尚不支持（见 issue #88）。
import "string";

import "panic";

import "macros";

/// 标记一个应通过的测试函数（identity token 宏；运行器按标注发现用例）
#[macro(tokens)]
pub fn test(String input) -> String {
    return input;
}

/// 标记一个应当 panic 的测试函数（运行器期望退出码 101）
#[macro(tokens)]
pub fn should_panic(String input) -> String {
    return input;
}

// ── 断言入口 ──
/// 断言失败入口：`failed == true` 时按调用点 panic
pub fn check(bool failed, int line, int col, String file, String msg) -> int {
    if failed {
        panic_at(line, col, file, msg);
        return 1;
    }
    return 0;
}

/// 浮点近似断言入口：|a - b| > eps 时 panic
pub fn check_close(float a, float b, float eps, int line, int col, String file, String msg) -> int {
    d = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > eps {
        panic_at(line, col, file, msg);
        return 1;
    }
    return 0;
}

// ── 宏辅助（编译期执行） ──
/// 把源码文本转义进生成代码的字符串字面量
#[alloc]
#[state]
fn escape_from(String s, usize i) -> String {
    if i >= s.len() {
        return "";
    }
    c = s.index(i);
    rest = escape_from(s, i + 1);
    if c == '"' {
        return "\\\"" + rest;
    }
    if c == '\\' {
        return "\\\\" + rest;
    }
    return c.to_string() + rest;
}

#[alloc]
#[state]
fn escape(String s) -> String {
    return escape_from(s, 0);
}

// ── assert 系列宏（token 宏：实参为 token 流，见 meta/macros.aya） ──
/// `#assert_eq(a, b)`：`a == b` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_eq(String input, String a, String b, int __line, int __col, String __file) -> String {
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    ts = TokenStream::new();
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, "==");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_eq failed: " + escape(src_a) + " == " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert(a)`：`!<cond>` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert(String input, String cond, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(cond);
    src_a = TokenStream::to_source(at);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assertion failed: " + escape(src_a) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert_ne(a, b)`：`!(a != b)` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_ne(String input, String a, String b, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, "!=");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_ne failed: " + escape(src_a) + " != " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert_lt(a, b)`：`!(a < b)` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_lt(String input, String a, String b, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, "<");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_lt failed: " + escape(src_a) + " < " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert_le(a, b)`：`!(a <= b)` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_le(String input, String a, String b, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, "<=");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_le failed: " + escape(src_a) + " <= " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#assert_gt(a, b)`：`!(a > b)` 不成立时抛断言（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_gt(String input, String a, String b, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    TokenStream::push_ident(ts, "check");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "!");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ">");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_gt failed: " + escape(src_a) + " > " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

