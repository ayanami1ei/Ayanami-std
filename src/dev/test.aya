/// `#assert_close(a, b, eps)`：`check_close(a, b, eps, L, C, "F", "assert_close failed: A ~ B")`（token 宏）
#[alloc]
#[state]
#[macro(tokens)]
pub fn assert_close(String input, String a, String b, String eps, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    at = TokenStream::from_bytes(a);
    bt = TokenStream::from_bytes(b);
    et = TokenStream::from_bytes(eps);
    src_a = TokenStream::to_source(at);
    src_b = TokenStream::to_source(bt);
    TokenStream::push_ident(ts, "check_close");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, at);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, bt);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_punct(ts, "(");
    TokenStream::append(ts, et);
    TokenStream::push_punct(ts, ")");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"assert_close failed: " + escape(src_a) + " ~ " + escape(src_b) + "\"");
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}

/// `#fail(msg)`：抛 panic（token 宏：实参为 token 流）
#[alloc]
#[state]
#[macro(tokens)]
pub fn fail(String input, String msg, int __line, int __col, String __file) -> String {
    ts = TokenStream::new();
    mt = TokenStream::from_bytes(msg);
    TokenStream::push_ident(ts, "panic_at");
    TokenStream::push_punct(ts, "(");
    TokenStream::push_literal(ts, __line.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, __col.to_string());
    TokenStream::push_punct(ts, ",");
    TokenStream::push_literal(ts, "\"" + __file + "\"");
    TokenStream::push_punct(ts, ",");
    TokenStream::append(ts, mt);
    TokenStream::push_punct(ts, ")");
    return TokenStream::to_bytes(ts);
}
