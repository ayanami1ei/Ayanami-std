// option — Option / Result / Error 基础类型
// 独立成模块以打破依赖环：std 与 convert 等共享，不反向依赖 io/std。
import "string";

import "panic";

interface Error {
    fn what(ref self) -> String;
}

pub enum Result[T, E] {
    Ok(T),
    Err(E),
}

pub enum Option[T] {
    Some(T),
    None,
}

impl[T] Option[T] {
    fn unwrap_or(self, T default) -> T {
        if self._tag == 0 {
            return self._data_Some._0;
        }
        return default;
    }
    fn is_some(self) -> bool {
        return self._tag == 0;
    }
    fn is_none(self) -> bool {
        return self._tag != 0;
    }
    /// 或：Some 返回自身，None 返回 other
    fn or(self, Option[T] other) -> Option[T] {
        if self._tag == 0 {
            return self;
        }
        return other;
    }
    /// Some 取值；None 触发 panic（退出码 101）
    #[alloc]
    fn unwrap(self, int __line, int __col, String __file) -> T {
        if self._tag == 0 {
            return self._data_Some._0;
        }
        panic_at(__line, __col, __file, "called `Option::unwrap` on a None value");
        return self._data_Some._0;
    }
    /// Some 取值；None 触发带自定义消息的 panic
    fn expect(self, String msg, int __line, int __col, String __file) -> T {
        if self._tag == 0 {
            return self._data_Some._0;
        }
        panic_at(__line, __col, __file, msg);
        return self._data_Some._0;
    }
    /// 有值取值，否则用 `f()` 生成
    fn unwrap_or_else(self, Fn()->T f) -> T {
        match self {
            Some(v) => v,
            None => f(),
        }
    }
    /// 映射或返回默认值
    fn map_or[U](self, U default, Fn(T)->U f) -> U {
        match self {
            Some(v) => f(v),
            None => default,
        }
    }
    /// 映射：`Some(v) → Some(f(v))`
    fn map[U](self, Fn(T)->U f) -> Option[U] {
        match self {
            Some(v) => Option::Some(f(v)),
            None => Option::None(),
        }
    }
    /// 链式：`Some(v) → f(v)`（`f` 返回 `Option[U]`）
    fn and_then[U](self, Fn(T)->Option[U] f) -> Option[U] {
        match self {
            Some(v) => f(v),
            None => Option::None(),
        }
    }
    /// 过滤：谓词为假时变 `None`
    fn filter(self, Fn(T)->bool f) -> Option[T] {
        match self {
            Some(v) => if f(v) {
                Option::Some(v)
            } else {
                Option::None()
            },
            None => Option::None(),
        }
    }
}

impl[T, E] Result[T, E] {
    fn is_ok(self) -> bool {
        return self._tag == 0;
    }
    fn is_err(self) -> bool {
        return self._tag != 0;
    }
    /// Ok 取值，Err 用默认值
    fn unwrap_or(self, T default) -> T {
        if self._tag == 0 {
            return self._data_Ok._0;
        }
        return default;
    }
    /// Ok → Some(v)，Err → None
    fn ok(self) -> Option[T] {
        if self._tag == 0 {
            return Option::Some(self._data_Ok._0);
        }
        return Option::None();
    }
    /// Ok 取值，Err 用 `f(e)` 生成
    fn unwrap_or_else(self, Fn(E)->T f) -> T {
        match self {
            Ok(v) => v,
            Err(e) => f(e),
        }
    }
    /// 映射 Ok 或返回默认值
    fn map_or[U](self, U default, Fn(T)->U f) -> U {
        match self {
            Ok(v) => f(v),
            Err(_) => default,
        }
    }
    /// 映射 Ok 值
    fn map[U](self, Fn(T)->U f) -> Result[U, E] {
        match self {
            Ok(v) => Result::Ok(f(v)),
            Err(e) => Result::Err(e),
        }
    }
    /// 映射 Err 值
    fn map_err[F](self, Fn(E)->F f) -> Result[T, F] {
        match self {
            Ok(v) => Result::Ok(v),
            Err(e) => Result::Err(f(e)),
        }
    }
    /// Ok 取值；Err 触发 panic（退出码 101）
    #[alloc]
    fn unwrap(self, int __line, int __col, String __file) -> T {
        if self._tag == 0 {
            return self._data_Ok._0;
        }
        panic_at(__line, __col, __file, "called `Result::unwrap` on an Err value");
        return self._data_Ok._0;
    }
    /// Ok 取值；Err 触发带自定义消息的 panic
    fn expect(self, String msg, int __line, int __col, String __file) -> T {
        if self._tag == 0 {
            return self._data_Ok._0;
        }
        panic_at(__line, __col, __file, msg);
        return self._data_Ok._0;
    }
}
