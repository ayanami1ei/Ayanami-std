// num — 显式溢出算术（wrapping / saturating / overflowing / checked）
//
// 默认 `+`/`-`/`*` 溢出时 panic；本模块提供显式语义的替代。
// 底层由 core/arch_x86_64.aya 的内联汇编实现（机器相关，x86-64）。
import "option";

import "arch_x86_64";

/// 溢出结果：`value` 为环绕值，`overflow` 为是否发生溢出
pub struct Overflowing {
    int value
    bool overflow
}

/// 环绕加法（溢出回绕）
#[pure]
pub fn wrapping_add(int a, int b) -> int {
    return ArchX86_64::wrapping_add(a, b);
}

/// 环绕减法
#[pure]
pub fn wrapping_sub(int a, int b) -> int {
    return ArchX86_64::wrapping_sub(a, b);
}

/// 环绕乘法
#[pure]
pub fn wrapping_mul(int a, int b) -> int {
    return ArchX86_64::wrapping_mul(a, b);
}

/// 环绕取负
#[pure]
pub fn wrapping_neg(int a) -> int {
    return ArchX86_64::wrapping_neg(a);
}

/// 加法是否溢出
#[pure]
pub fn add_overflow(int a, int b) -> bool {
    return ArchX86_64::add_overflow(a, b) == 1;
}

/// 减法是否溢出
#[pure]
pub fn sub_overflow(int a, int b) -> bool {
    return ArchX86_64::sub_overflow(a, b) == 1;
}

/// 乘法是否溢出
#[pure]
pub fn mul_overflow(int a, int b) -> bool {
    return ArchX86_64::mul_overflow(a, b) == 1;
}

/// 饱和加法（溢出取边界值）
#[pure]
pub fn saturating_add(int a, int b) -> int {
    return ArchX86_64::saturating_add(a, b);
}

/// 饱和减法
#[pure]
pub fn saturating_sub(int a, int b) -> int {
    return ArchX86_64::saturating_sub(a, b);
}

/// 饱和乘法
#[pure]
pub fn saturating_mul(int a, int b) -> int {
    return ArchX86_64::saturating_mul(a, b);
}

/// 环绕加法（带溢出标记）
#[pure]
pub fn overflowing_add(int a, int b) -> Overflowing {
    return Overflowing { value = ArchX86_64::wrapping_add(a, b), overflow = ArchX86_64::add_overflow(a, b) == 1 };
}

/// 环绕减法（带溢出标记）
#[pure]
pub fn overflowing_sub(int a, int b) -> Overflowing {
    return Overflowing { value = ArchX86_64::wrapping_sub(a, b), overflow = ArchX86_64::sub_overflow(a, b) == 1 };
}

/// 环绕乘法（带溢出标记）
#[pure]
pub fn overflowing_mul(int a, int b) -> Overflowing {
    return Overflowing { value = ArchX86_64::wrapping_mul(a, b), overflow = ArchX86_64::mul_overflow(a, b) == 1 };
}

/// 取负是否溢出（仅 `i64::MIN`）
#[pure]
pub fn neg_overflow(int a) -> bool {
    return a == 0 - 9223372036854775807 - 1;
}

/// 饱和取负（`i64::MIN` 饱和为 `i64::MAX`）
#[pure]
pub fn saturating_neg(int a) -> int {
    if neg_overflow(a) {
        return 9223372036854775807;
    }
    return wrapping_neg(a);
}

/// 环绕取负（带溢出标记）
#[pure]
pub fn overflowing_neg(int a) -> Overflowing {
    return Overflowing { value = wrapping_neg(a), overflow = neg_overflow(a) };
}

/// 检查取负（`i64::MIN` 返回 None）
#[pure]
pub fn checked_neg(int a) -> Option[int] {
    if neg_overflow(a) {
        return Option::None();
    }
    return Option::Some(wrapping_neg(a));
}

/// 检查加法（溢出返回 None）
#[pure]
pub fn checked_add(int a, int b) -> Option[int] {
    if add_overflow(a, b) {
        return Option::None();
    }
    return Option::Some(wrapping_add(a, b));
}

/// 检查减法
#[pure]
pub fn checked_sub(int a, int b) -> Option[int] {
    if sub_overflow(a, b) {
        return Option::None();
    }
    return Option::Some(wrapping_sub(a, b));
}

/// 检查乘法
#[pure]
pub fn checked_mul(int a, int b) -> Option[int] {
    if mul_overflow(a, b) {
        return Option::None();
    }
    return Option::Some(wrapping_mul(a, b));
}
