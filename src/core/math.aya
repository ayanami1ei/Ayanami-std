// Math helpers
// Usage: import "std/math.aya";

#[pure]
pub fn abs(int x) -> int {
    if x < 0 { return -x; }
    return x;
}

#[pure]
pub fn min(int a, int b) -> int {
    if a < b { return a; }
    return b;
}

#[pure]
pub fn max(int a, int b) -> int {
    if a > b { return a; }
    return b;
}

#[pure]
pub fn sign(int x) -> int {
    if x < 0 {
        return 0 - 1
    }
    if x > 0 {
        return 1
    }
    return 0
}

#[pure]
pub fn clamp(int x, int lo, int hi) -> int {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

#[pure]
pub fn pow(int base, int exp) -> int {
    result = 1;
    for i in (0, exp) {
        result = result * base;
    }
    return result;
}

// ── A6：浮点重载与数学函数 ──

#[pure]
extern "C" fn __ayanami_sqrt(float x) -> float;
#[pure]
extern "C" fn __ayanami_floor(float x) -> float;
#[pure]
extern "C" fn __ayanami_ceil(float x) -> float;
#[pure]
extern "C" fn __ayanami_float_is_nan(float x) -> int;
#[pure]
extern "C" fn __ayanami_exp(float x) -> float;
#[pure]
extern "C" fn __ayanami_log(float x) -> float;
#[pure]
extern "C" fn __ayanami_log10(float x) -> float;
#[pure]
extern "C" fn __ayanami_round(float x) -> float;
#[pure]
extern "C" fn __ayanami_trunc(float x) -> float;
#[pure]
extern "C" fn __ayanami_sin(float x) -> float;
#[pure]
extern "C" fn __ayanami_cos(float x) -> float;
#[pure]
extern "C" fn __ayanami_tan(float x) -> float;
#[pure]
extern "C" fn __ayanami_atan2(float y, float x) -> float;

#[pure]
pub fn abs(float x) -> float {
    if x < 0.0 { return -x }
    return x
}

#[pure]
pub fn min(float a, float b) -> float {
    if a < b { return a }
    return b
}

#[pure]
pub fn max(float a, float b) -> float {
    if a > b { return a }
    return b
}

#[pure]
pub fn clamp(float x, float lo, float hi) -> float {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

#[pure]
pub fn sqrt(float x) -> float { return __ayanami_sqrt(x) }

#[pure]
pub fn floor(float x) -> float { return __ayanami_floor(x) }

#[pure]
pub fn ceil(float x) -> float { return __ayanami_ceil(x) }

/// e^x
#[pure]
pub fn exp(float x) -> float { return __ayanami_exp(x) }

/// 自然对数
#[pure]
pub fn ln(float x) -> float { return __ayanami_log(x) }

/// 常用对数（底 10）
#[pure]
pub fn log10(float x) -> float { return __ayanami_log10(x) }

/// 四舍五入（half away from zero）
#[pure]
pub fn round(float x) -> float { return __ayanami_round(x) }

/// 向零截断
#[pure]
pub fn trunc(float x) -> float { return __ayanami_trunc(x) }

/// 圆周率
#[pure]
pub fn pi() -> float { return 3.141592653589793 }

/// 正弦
#[pure]
pub fn sin(float x) -> float { return __ayanami_sin(x) }

/// 余弦
#[pure]
pub fn cos(float x) -> float { return __ayanami_cos(x) }

/// 正切
#[pure]
pub fn tan(float x) -> float { return __ayanami_tan(x) }

/// 方位角 atan2(y, x)
#[pure]
pub fn atan2(float y, float x) -> float { return __ayanami_atan2(y, x) }

#[pure]
pub fn pow(float base, int exp) -> float {
    result = 1.0
    for i in (0, exp) {
        result = result * base
    }
    return result
}

// ── 数论与整数工具 ──

/// 最大公约数（`gcd(0, 0) == 0`）
#[pure]
pub fn gcd(int a, int b) -> int {
    x = abs(a)
    y = abs(b)
    while y != 0 {
        t = x % y
        x = y
        y = t
    }
    return x
}

/// 最小公倍数（任一为 0 返回 0）
#[pure]
pub fn lcm(int a, int b) -> int {
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }
    return abs(a / gcd(a, b)) * abs(b)
}

/// 是否素数（`n < 2` 为 false）
#[pure]
pub fn is_prime(int n) -> bool {
    if n < 2 {
        return false
    }
    if n % 2 == 0 {
        return n == 2
    }
    d = 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d = d + 2
    }
    return true
}

impl int {
    /// 是否偶数
    #[pure]
    pub fn is_even(self) -> bool {
        return self % 2 == 0
    }

    /// 是否奇数
    #[pure]
    pub fn is_odd(self) -> bool {
        return self % 2 != 0
    }
}

impl float {
    /// 是否 NaN（runtime `isnan`）
    #[pure]
    pub fn is_nan(self) -> bool {
        return __ayanami_float_is_nan(self) != 0
    }
}
