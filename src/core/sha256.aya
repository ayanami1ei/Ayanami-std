fn load_h() -> [int; 8] {
    h = [int; 8];
    h[0] = 1779033703;
    h[1] = 3144134277;
    h[2] = 1013904242;
    h[3] = 2773480762;
    h[4] = 1359893119;
    h[5] = 2600822924;
    h[6] = 528734635;
    h[7] = 1541459225;
    return h;
}

/// SHA-256 原始摘要（32 字节）
#[alloc]
#[state]
pub fn sha256_bytes(ref String s) -> String {
    n = s.len as int;
    total = (n + 9 + 63) / 64 * 64;
    total_u = total as usize;
    buf = [char; total_u];
    i = 0;
    while i < n {
        buf[i as usize] = s.data[i as usize];
        i = i + 1;
    }
    buf[n as usize] = 128 as char;
    bit_len = n * 8;
    j = 0;
    while j < 8 {
        shift = (7 - j) * 8;
        buf[(total - 8 + j) as usize] = (bit_len >> shift & 255) as char;
        j = j + 1;
    }
    k = load_k();
    h = load_h();
    blocks = total / 64;
    w = [int; 64];
    b = 0;
    while b < blocks {
        base = b * 64;
        t = 0;
        while t < 16 {
            p = base + t * 4;
            w[t] = buf[p as usize] as int << 24 | buf[(p + 1) as usize] as int << 16 | buf[(p + 2) as usize] as int << 8 | buf[(p + 3) as usize] as int;
            t = t + 1;
        }
        while t < 64 {
            w[t] = small_sigma1(w[t - 2]) + w[t - 7] + small_sigma0(w[t - 15]) + w[t - 16] & MASK32;
            t = t + 1;
        }
        a = h[0];
        bb = h[1];
        c = h[2];
        d = h[3];
        e = h[4];
        f = h[5];
        g = h[6];
        hh = h[7];
        t = 0;
        while t < 64 {
            t1 = hh + big_sigma1(e) + ch(e, f, g) + k[t] + w[t] & MASK32;
            t2 = big_sigma0(a) + maj(a, bb, c) & MASK32;
            hh = g;
            g = f;
            f = e;
            e = d + t1 & MASK32;
            d = c;
            c = bb;
            bb = a;
            a = t1 + t2 & MASK32;
            t = t + 1;
        }
        h[0] = h[0] + a & MASK32;
        h[1] = h[1] + bb & MASK32;
        h[2] = h[2] + c & MASK32;
        h[3] = h[3] + d & MASK32;
        h[4] = h[4] + e & MASK32;
        h[5] = h[5] + f & MASK32;
        h[6] = h[6] + g & MASK32;
        h[7] = h[7] + hh & MASK32;
        b = b + 1;
    }
    res = [char; 32];
    x = 0;
    while x < 8 {
        v = h[x];
        res[x * 4] = (v >> 24 & 255) as char;
        res[x * 4 + 1] = (v >> 16 & 255) as char;
        res[x * 4 + 2] = (v >> 8 & 255) as char;
        res[x * 4 + 3] = (v & 255) as char;
        x = x + 1;
    }
    return String::new(res, 32usize);
}

/// SHA-256 十六进制摘要（64 字符小写）
#[alloc]
#[state]
pub fn sha256_hex(ref String s) -> String {
    raw = sha256_bytes(s);
    return hex_encode(ref raw);
}
