// arch_x86_64 — x86-64 机器级助手（Ayanami 内联汇编）
//
// 试验：把运行时中短小的汇编助手迁到 Ayanami 内联汇编（std 自带实现，不再经运行时 extern）。
// 语义与 runtime 的 __ayanami_{wrapping_*, *_overflow, saturating_*} 完全一致（见 core/num.aya）。
//
// 内联汇编约定（本编译器）：
// - $0=输出，$1..=输入（输出在前编号，与源码顺序无关）；
// - 立即数写作 $$N（$$ 为 $ 转义）；8 位寄存器写作 %al（单百分号）；
// - 唯一标签用 ${:uid} 前缀（LLVM 原生机制）；
// - 输出在读完全部输入前写入时标 `out(early reg)`（early-clobber，避免与输入寄存器别名，#198）。
//
// 目标平台：x86-64（System V）。其他架构需提供对应 arch_* 模块。
pub namespace ArchX86_64 {
    /// 环绕加法
    pub fn wrapping_add(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("leaq ($1,$2), $0", out(reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 环绕减法
    pub fn wrapping_sub(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("movq $1, $0\n subq $2, $0", out(early reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 环绕乘法
    pub fn wrapping_mul(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("movq $1, $0\n imulq $2, $0", out(early reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 环绕取负
    pub fn wrapping_neg(int a) -> int {
        r = 0;
        unsafe {
            asm("xorq $0, $0\n subq $1, $0", out(early reg) r, in(reg) a)
        }
        return r;
    }
    /// 加法溢出（1/0）
    pub fn add_overflow(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("movq $1, $0\n addq $2, $0\n seto %al\n movzbq %al, $0", out(early reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 减法溢出（1/0）
    pub fn sub_overflow(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("movq $1, $0\n subq $2, $0\n seto %al\n movzbq %al, $0", out(early reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 乘法溢出（1/0）
    pub fn mul_overflow(int a, int b) -> int {
        r = 0;
        unsafe {
            asm("movq $1, $0\n imulq $2, $0\n seto %al\n movzbq %al, $0", out(early reg) r, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 饱和加法（溢出取边界：a>0 → MAX，否则 MIN；无分支 cmov）
    pub fn saturating_add(int a, int b) -> int {
        r = 0;
        t = 0;
        m = 0;
        unsafe {
            asm("movabsq $$0x7fffffffffffffff, $1\n movabsq $$0x8000000000000000, $2\n testq $3, $3\n cmovleq $2, $1\n movq $3, $0\n addq $4, $0\n cmovoq $1, $0", out(early reg) r, out(early reg) t, out(early reg) m, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 饱和减法（溢出取边界：a>0 → MAX，否则 MIN；无分支 cmov）
    pub fn saturating_sub(int a, int b) -> int {
        r = 0;
        t = 0;
        m = 0;
        unsafe {
            asm("movabsq $$0x7fffffffffffffff, $1\n movabsq $$0x8000000000000000, $2\n testq $3, $3\n cmovleq $2, $1\n movq $3, $0\n subq $4, $0\n cmovoq $1, $0", out(early reg) r, out(early reg) t, out(early reg) m, in(reg) a, in(reg) b)
        }
        return r;
    }
    /// 饱和乘法（溢出方向按符号异或判定；无分支 cmov）
    pub fn saturating_mul(int a, int b) -> int {
        r = 0;
        s = 0;
        hi = 0;
        lo = 0;
        unsafe {
            asm("movq $4, $1\n xorq $5, $1\n movabsq $$0x7fffffffffffffff, $2\n movabsq $$0x8000000000000000, $3\n testq $1, $1\n cmovsq $3, $2\n movq $4, $0\n imulq $5, $0\n cmovoq $2, $0", out(early reg) r, out(early reg) s, out(early reg) hi, out(early reg) lo, in(reg) a, in(reg) b)
        }
        return r;
    }
}
